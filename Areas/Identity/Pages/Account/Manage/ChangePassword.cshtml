@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center mb-4">
    <a href="/Settings" class="btn btn-outline-secondary me-3"><i class="fa-solid fa-arrow-left me-2"></i>Back to Settings</a>
    <h3 class="mb-0">Security Settings</h3>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="clinic-card">
            <h4 class="mb-4 border-bottom pb-2">@ViewData["Title"]</h4>
            
            <partial name="_StatusMessage" for="StatusMessage" />
            
            <form id="change-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                
                <div class="mb-3">
                    <label asp-for="Input.OldPassword" class="form-label fw-bold"></label>
                    <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Enter your current password" />
                    <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Input.NewPassword" class="form-label fw-bold"></label>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Enter a strong new password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>
                
                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-bold"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm your new password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
                
                <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-lock me-2"></i>Update Password</button>
            </form>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="clinic-card bg-light border-0">
            <h5 class="mb-3"><i class="fa-solid fa-shield-halved text-primary me-2"></i>Password Requirements</h5>
            <ul class="text-muted small ps-3 mb-0" style="line-height: 1.8;">
                <li>Must be at least 6 characters long</li>
                <li>Must contain at least one non-alphanumeric character</li>
                <li>Must contain at least one digit ('0'-'9')</li>
                <li>Must contain at least one uppercase ('A'-'Z')</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
