@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
    <img src="~/images/hu-logo.png" alt="Hawassa University Emblem" style="width: 44px; height: 44px; object-fit: contain;" />
    <div>
        <div class="auth-form-brand-title">Hawassa University</div>
        <div class="auth-form-brand-sub">IoT Student Clinic Portal</div>
    </div>
</div>

<h2 class="auth-form-title">Reset Password</h2>
<p class="auth-form-subtitle">Choose a new, secure password for your clinic account.</p>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="auth-validation-summary alert alert-danger small py-2 px-3 mb-3" role="alert" aria-live="polite"></div>
    <input asp-for="Input.Code" type="hidden" />

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label fw-semibold">Email Address</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" readonly />
        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block" aria-live="polite"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label fw-semibold">New Password</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Enter new password" />
        <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block" aria-live="polite"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block" aria-live="polite"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold auth-submit-btn">
        <i class="fa-solid fa-key me-2"></i> Update Password
    </button>
</form>

<div class="text-center mt-4">
    <a asp-page="./Login" class="text-decoration-none fw-semibold small auth-forgot-link">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Sign In
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
