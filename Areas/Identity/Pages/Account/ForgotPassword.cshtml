@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-form-eyebrow">Account Recovery</div>
<h2 class="auth-form-title">Forgot your password?</h2>
<p class="auth-form-subtitle">Enter your email and we'll send you a reset link.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Email Address</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Enter your email" />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2">
        <i class="fa-solid fa-paper-plane me-2"></i> Reset Password
    </button>
</form>

<div class="text-center mt-4">
    <a asp-page="./Login" class="text-decoration-none fw-semibold small">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Sign In
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}