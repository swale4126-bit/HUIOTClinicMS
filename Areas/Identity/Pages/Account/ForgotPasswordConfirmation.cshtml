@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Password Reset Request";
}

<div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
    <img src="~/images/hu-logo.png" alt="Hawassa University Emblem" style="width: 44px; height: 44px; object-fit: contain;" />
    <div>
        <div class="auth-form-brand-title">Hawassa University</div>
        <div class="auth-form-brand-sub">IoT Student Clinic Portal</div>
    </div>
</div>

<h2 class="auth-form-title">Password Reset</h2>

@if (TempData["DevResetLink"] is string devLink)
{
    <div class="alert alert-info border-0 shadow-sm small mb-3">
        <div class="d-flex align-items-start gap-2">
            <i class="fa-solid fa-circle-info mt-1 text-primary" aria-hidden="true"></i>
            <div>
                <strong>Password Reset Link Ready</strong>
                <div class="text-muted mt-1">
                    Direct recovery link for <strong>@TempData["DevResetEmail"]</strong>:
                </div>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <a href="@devLink" class="btn btn-primary w-100 py-2 fw-semibold">
            <i class="fa-solid fa-key me-2"></i> Reset Password Now
        </a>
    </div>
}
else
{
    <div class="alert alert-success border-0 shadow-sm small mb-4">
        <div class="d-flex align-items-start gap-2">
            <i class="fa-solid fa-envelope-circle-check mt-1 text-success" aria-hidden="true"></i>
            <div>
                <strong>Instructions Sent</strong>
                <p class="mb-0 mt-1">
                    If an account with that email exists, password reset instructions have been sent. Please check your inbox and spam folder.
                </p>
            </div>
        </div>
    </div>
}

<div class="text-center mt-4">
    <a asp-page="./Login" class="text-decoration-none fw-semibold small auth-forgot-link">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Sign In
    </a>
</div>