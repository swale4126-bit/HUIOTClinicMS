@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<div class="auth-form-eyebrow">Account Recovery</div>
<h2 class="auth-form-title">Check your link</h2>

@if (TempData["DevResetLink"] is string devLink)
{
    <div class="alert alert-warning small">
        <strong>Development mode</strong> — no email provider is configured yet, so here's
        the reset link directly (this would normally be emailed to
        <strong>@TempData["DevResetEmail"]</strong>):
    </div>
    <div class="mb-3">
        <a href="@devLink" class="btn btn-primary w-100 py-2">
            <i class="fa-solid fa-key me-2"></i> Reset Password Now
        </a>
    </div>
}
else
{
    <p class="auth-form-subtitle">
        If an account with that email exists, a password reset link has been sent.
    </p>
}

<div class="text-center mt-4">
    <a asp-page="./Login" class="text-decoration-none fw-semibold small">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Sign In
    </a>
</div>