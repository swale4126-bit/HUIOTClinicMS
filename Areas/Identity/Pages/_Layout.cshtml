<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HU IoT Clinic</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell">

        <aside class="auth-brand-panel">
            <div class="auth-brand-top">
                <div class="auth-brand-badge"><i class="fa-solid fa-stethoscope"></i></div>
                <div>
                    <strong class="auth-brand-name">HU IoT Clinic</strong>
                    <span class="auth-brand-sub">Hawassa University</span>
                </div>
            </div>

            <div class="auth-brand-mid">
                <h1 class="auth-brand-headline">Care, <em>connected</em>.</h1>
                <p class="auth-brand-copy">
                    One system for patient records, lab results, and prescriptions
                    across every clinic role — from registration to pharmacy.
                </p>

                <div class="ecg-wrap" aria-hidden="true">
                    <div class="ecg-track">
                        <svg viewBox="0 0 300 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M0,30 H70 L85,8 L100,52 L115,18 L130,30 H300 L315,8 L330,52 L345,18 L360,30" />
                        </svg>
                        <svg viewBox="0 0 300 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M0,30 H70 L85,8 L100,52 L115,18 L130,30 H300 L315,8 L330,52 L345,18 L360,30" />
                        </svg>
                    </div>
                </div>

                <ul class="auth-feature-list">
                    <li><i class="fa-solid fa-check"></i> Unified records for every role</li>
                    <li><i class="fa-solid fa-check"></i> Real-time lab &amp; pharmacy status</li>
                    <li><i class="fa-solid fa-check"></i> Secure, role-based access</li>
                </ul>
            </div>

            <div class="auth-brand-footer">
                &copy; @DateTime.Now.Year Hawassa University &mdash; IoT Student Clinic
            </div>
        </aside>

        <div class="auth-form-panel">
            <div class="auth-form-inner">
                @RenderBody()
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>