<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HU IoT Clinic</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell">

        <aside class="auth-brand-panel">
            <div class="auth-brand-top">
                <div class="auth-brand-badge shadow-sm">
                    <img src="~/images/hu-logo.png" alt="Hawassa University" style="width: 36px; height: 36px; object-fit: contain;" />
                </div>
                <div>
                    <strong class="auth-brand-name">HU IoT Clinic</strong>
                    <span class="auth-brand-sub">Hawassa University</span>
                </div>
            </div>

            <div class="auth-brand-mid">
                <h1 class="auth-brand-headline">Care, <em>connected.</em></h1>
                <p class="auth-brand-copy">
                    One system for patient records, lab results, and prescriptions across every clinic role &mdash; from registration to pharmacy.
                </p>

                <div class="auth-ecg-line">
                    <svg viewBox="0 0 320 48" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0,24 H80 L92,8 L104,40 L116,16 L128,24 H320" />
                    </svg>
                </div>

                <ul class="auth-feature-list">
                    <li><i class="fa-solid fa-check"></i> Unified records for every role</li>
                    <li><i class="fa-solid fa-check"></i> Real-time lab &amp; pharmacy status</li>
                    <li><i class="fa-solid fa-check"></i> Secure, role-based access</li>
                </ul>
            </div>
        </aside>

        <div class="auth-form-panel">
            <div class="auth-form-inner">
                @RenderBody()
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>