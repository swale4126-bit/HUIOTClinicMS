@model IEnumerable<HUIOTClinicMS.Models.Patient>
@{
    ViewData["Title"] = "Patient Records";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="clinic-card">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <strong>Patient Records (@Model.Count())</strong>
        <div class="d-flex gap-2 flex-wrap">
            <form method="get" class="d-flex">
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Search by ID Number..." style="min-width:200px;" />
                <button type="submit" class="btn btn-outline-primary btn-sm ms-2"><i class="fa-solid fa-magnifying-glass"></i></button>
            </form>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-user-plus me-1"></i> Register Patient
            </a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>ID Number</th>
                    <th>Card No.</th>
                    <th>Full Name</th>
                    <th>Gender</th>
                    <th>Department</th>
                    <th>Dorm</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="small text-muted">@item.IDNumber</td>
                        <td class="small text-muted">@item.CardNumber</td>
                        <td>@item.FirstName @item.LastName</td>
                        <td>@item.Gender</td>
                        <td>@(item.Department?.DepartmentName ?? "—")</td>
                        <td>@(item.DormBlock?.BlockName ?? "—")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge badge-status-active">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-status-inactive">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-outline-primary btn-sm">View</a>
                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-outline-primary btn-sm">Edit</a>
                            @if (User.IsInRole("HealthOfficer"))
                            {
                                <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-outline-primary btn-sm text-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted small py-3">
                            @(string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string) ? "No patients registered yet." : $"No patients match \"{ViewBag.SearchTerm}\".")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
