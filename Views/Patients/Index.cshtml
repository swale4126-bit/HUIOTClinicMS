@model IEnumerable<HUIOTClinicMS.Models.Patient>
@{
    ViewData["Title"] = "Patient Records";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="clinic-card border-0 shadow-sm mb-4">
    <div class="border-bottom pb-3 mb-3">
        <h5 class="mb-1 text-primary"><i class="fa-solid fa-id-card-clip me-2"></i>Patient Search & Identification Desk</h5>
        <p class="text-muted small mb-0">Search by Student ID Number or Clinic Card Number to verify patient identity before initiating clinical care or registering a new student.</p>
    </div>

    <form method="get" class="mb-3">
        <div class="input-group input-group-lg shadow-sm">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Search by Student ID (e.g. 2425) or Clinic Card (e.g. HU-2026-0001) or Name..." autofocus />
            <button type="submit" class="btn btn-primary px-4 fw-semibold"><i class="fa-solid fa-search me-1"></i> Search Patient</button>
            @if (ViewBag.HasSearched == true)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </form>

    @if (ViewBag.HasSearched == true)
    {
        var exactMatch = ViewBag.ExactMatch as HUIOTClinicMS.Models.Patient;
        var history = ViewBag.PatientHistory as HUIOTClinicMS.ViewModels.PatientDetailsViewModel;
        if (exactMatch != null)
        {
            <div class="alert alert-success border-success shadow-sm mb-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="badge bg-success mb-1"><i class="fa-solid fa-check-circle me-1"></i> Identity Verified</span>
                        <h5 class="mb-1 text-dark">@exactMatch.FirstName @exactMatch.LastName</h5>
                        <div class="small text-muted">
                            Student ID: <strong>@exactMatch.IDNumber</strong> &bull; 
                            Card No: <strong>@(exactMatch.CardNumber ?? "—")</strong> &bull; 
                            Department: <strong>@(exactMatch.Department?.DepartmentName ?? "—")</strong> &bull; 
                            Dorm: <strong>@(exactMatch.DormBlock?.BlockName ?? "—")</strong>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        @if (User.IsInRole("Nurse") || User.IsInRole("HealthOfficer"))
                        {
                            <a asp-action="Handover" asp-route-id="@exactMatch.ID" class="btn btn-primary btn-sm px-3 shadow-sm fw-semibold">
                                <i class="fa-solid fa-people-arrows me-1"></i> Handover to Nurse
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- COMPREHENSIVE PREVIOUS PATIENT CLINICAL HISTORY -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h6 class="mb-0 text-primary fw-bold">
                            <i class="fa-solid fa-notes-medical me-2"></i> Comprehensive Medical & Clinical History: @exactMatch.FirstName @exactMatch.LastName
                        </h6>
                        <span class="text-muted small">Longitudinal electronic health records, diagnostic tests, and past prescriptions</span>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 border">
                            <i class="fa-solid fa-clock-rotate-left me-1"></i> @(history?.Encounters?.Count ?? 0) Visit(s)
                        </span>
                        <span class="badge bg-info bg-opacity-10 text-dark px-3 py-2 border">
                            <i class="fa-solid fa-flask me-1 text-info"></i> @(history?.LabRequests?.Count ?? 0) Lab Request(s)
                        </span>
                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 border">
                            <i class="fa-solid fa-square-poll-vertical me-1"></i> @(history?.LabResults?.Count ?? 0) Lab Result(s)
                        </span>
                        <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-2 border">
                            <i class="fa-solid fa-prescription-bottle-medical me-1 text-warning"></i> @(history?.Prescriptions?.Count ?? 0) Prescription(s)
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <ul class="nav nav-tabs nav-fill bg-light px-3 pt-2 border-bottom" id="patientHistoryTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-semibold" id="records-tab" data-bs-toggle="tab" data-bs-target="#tab-records" type="button" role="tab">
                                <i class="fa-solid fa-book-medical me-1 text-primary"></i> Medical Records (@(history?.MedicalRecords?.Count ?? 0))
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-semibold" id="labs-tab" data-bs-toggle="tab" data-bs-target="#tab-labs" type="button" role="tab">
                                <i class="fa-solid fa-flask-vial me-1 text-info"></i> Lab Requests & Results (@(history?.LabRequests?.Count ?? 0))
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-semibold" id="rxs-tab" data-bs-toggle="tab" data-bs-target="#tab-rxs" type="button" role="tab">
                                <i class="fa-solid fa-pills me-1 text-warning"></i> Prescriptions & Dispensing (@(history?.Prescriptions?.Count ?? 0))
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-semibold" id="encounters-tab" data-bs-toggle="tab" data-bs-target="#tab-encounters" type="button" role="tab">
                                <i class="fa-solid fa-heart-pulse me-1 text-danger"></i> Triage & Encounters (@(history?.Encounters?.Count ?? 0))
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content p-3" id="patientHistoryTabsContent">
                        <!-- TAB 1: MEDICAL RECORDS -->
                        <div class="tab-pane fade show active" id="tab-records" role="tabpanel">
                            @if (history?.MedicalRecords != null && history.MedicalRecords.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover table-sm align-middle mb-0">
                                        <thead class="table-light small text-uppercase text-muted">
                                            <tr>
                                                <th>Date & Time</th>
                                                <th>Clinician</th>
                                                <th>Chief Complaint</th>
                                                <th>Diagnosis</th>
                                                <th>Treatment / Clinical Plan</th>
                                                <th>Notes</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var mr in history.MedicalRecords)
                                            {
                                                <tr class="small">
                                                    <td>
                                                        <strong>@mr.DateTime.ToString("yyyy-MM-dd")</strong>
                                                        <div class="text-muted">@mr.DateTime.ToString("HH:mm")</div>
                                                    </td>
                                                    <td>
                                                        <i class="fa-solid fa-user-doctor text-muted me-1"></i>
                                                        @(mr.CreatedByStaff != null ? $"{mr.CreatedByStaff.FirstName} {mr.CreatedByStaff.LastName}" : (mr.CreatedBy ?? "—"))
                                                    </td>
                                                    <td><strong class="text-dark">@(mr.ChiefComplaint ?? "—")</strong></td>
                                                    <td>
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1">
                                                            @(mr.Diagnosis ?? "Clinical Assessment")
                                                        </span>
                                                    </td>
                                                    <td>@(mr.Treatment ?? "—")</td>
                                                    <td class="text-muted">@(string.IsNullOrWhiteSpace(mr.Notes) ? "—" : mr.Notes)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 bg-light rounded text-muted small">
                                    <i class="fa-regular fa-clipboard fa-2x mb-2 text-secondary opacity-50"></i>
                                    <div>No previous consultation medical records registered.</div>
                                </div>
                            }
                        </div>

                        <!-- TAB 2: LAB REQUESTS & RESULTS -->
                        <div class="tab-pane fade" id="tab-labs" role="tabpanel">
                            @if ((history?.LabRequests != null && history.LabRequests.Any()) || (history?.LabResults != null && history.LabResults.Any()))
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover table-sm align-middle mb-0">
                                        <thead class="table-light small text-uppercase text-muted">
                                            <tr>
                                                <th>Request Date</th>
                                                <th>Requested Tests</th>
                                                <th>Ordered By</th>
                                                <th>Assigned Tech</th>
                                                <th>Status</th>
                                                <th>Lab Results / Findings</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (history?.LabRequests != null)
                                            {
                                                foreach (var req in history.LabRequests)
                                                {
                                                    var resultsForReq = history.LabResults?.Where(r => r.MedicalRecordID == req.MedicalRecordID).ToList() ?? new List<HUIOTClinicMS.Models.LabResult>();
                                                    <tr class="small">
                                                        <td>
                                                            <strong>@req.RequestDate.ToString("yyyy-MM-dd")</strong>
                                                            <div class="text-muted">@req.RequestDate.ToString("HH:mm")</div>
                                                        </td>
                                                        <td>
                                                            @if (req.TestTypes != null && req.TestTypes.Any())
                                                            {
                                                                foreach (var tt in req.TestTypes)
                                                                {
                                                                    <span class="badge bg-info bg-opacity-10 text-dark border me-1 mb-1">@tt.TestName</span>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span>General Lab Investigation</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <i class="fa-solid fa-user-nurse text-muted me-1"></i>
                                                            @(req.RequestedBy != null ? $"{req.RequestedBy.FirstName} {req.RequestedBy.LastName}" : "—")
                                                        </td>
                                                        <td>
                                                            @(req.AssignedToStaff != null ? $"{req.AssignedToStaff.FirstName} {req.AssignedToStaff.LastName}" : "Any Available")
                                                        </td>
                                                        <td>
                                                            @{
                                                                var stClass = req.Status switch {
                                                                    "Completed" => "bg-success",
                                                                    "InProgress" => "bg-warning text-dark",
                                                                    _ => "bg-secondary"
                                                                };
                                                            }
                                                            <span class="badge @stClass">@req.Status</span>
                                                        </td>
                                                        <td>
                                                            @if (resultsForReq.Any())
                                                            {
                                                                foreach (var res in resultsForReq)
                                                                {
                                                                    <div class="p-1 mb-1 bg-light rounded border">
                                                                        <strong>@(res.TestType?.TestName ?? "Test"):</strong> 
                                                                        <span class="text-primary fw-semibold">@res.Result</span>
                                                                        @if (!string.IsNullOrEmpty(res.Remark))
                                                                        {
                                                                            <small class="text-muted ms-1 fst-italic">(@res.Remark)</small>
                                                                        }
                                                                        <div class="text-muted" style="font-size: 0.72rem;">
                                                                            By @(res.ResultPerformedBy != null ? $"{res.ResultPerformedBy.FirstName} {res.ResultPerformedBy.LastName}" : "Lab")
                                                                        </div>
                                                                    </div>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted fst-italic">Pending results</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 bg-light rounded text-muted small">
                                    <i class="fa-solid fa-flask-vial fa-2x mb-2 text-secondary opacity-50"></i>
                                    <div>No previous laboratory requests or results recorded.</div>
                                </div>
                            }
                        </div>

                        <!-- TAB 3: PRESCRIPTIONS & PHARMACY -->
                        <div class="tab-pane fade" id="tab-rxs" role="tabpanel">
                            @if (history?.Prescriptions != null && history.Prescriptions.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover table-sm align-middle mb-0">
                                        <thead class="table-light small text-uppercase text-muted">
                                            <tr>
                                                <th>Prescribed Date</th>
                                                <th>Prescribed By</th>
                                                <th>Prescription (Rx) / Medication</th>
                                                <th>Dosage</th>
                                                <th>Status</th>
                                                <th>Dispensed Details</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var rx in history.Prescriptions)
                                            {
                                                <tr class="small">
                                                    <td>
                                                        <strong>@rx.TimeDate.ToString("yyyy-MM-dd")</strong>
                                                        <div class="text-muted">@rx.TimeDate.ToString("HH:mm")</div>
                                                    </td>
                                                    <td>
                                                        <i class="fa-solid fa-user-doctor text-muted me-1"></i>
                                                        @(rx.PrescribedBy != null ? $"{rx.PrescribedBy.FirstName} {rx.PrescribedBy.LastName}" : "—")
                                                    </td>
                                                    <td>
                                                        <strong class="text-dark">@(!string.IsNullOrEmpty(rx.Medication?.MedicationName) ? rx.Medication.MedicationName : rx.RX)</strong>
                                                        @if (!string.IsNullOrEmpty(rx.Medication?.MedicationType))
                                                        {
                                                            <span class="badge bg-light text-muted border ms-1">@rx.Medication.MedicationType</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @(rx.Medication?.PrescribedDose ?? "As directed")
                                                    </td>
                                                    <td>
                                                        @{
                                                            var rxStatusClass = rx.Status switch {
                                                                "Dispensed" => "bg-success",
                                                                "PartiallyDispensed" => "bg-info text-dark",
                                                                "Cancelled" => "bg-danger",
                                                                _ => "bg-warning text-dark"
                                                            };
                                                        }
                                                        <span class="badge @rxStatusClass">@rx.Status</span>
                                                    </td>
                                                    <td>
                                                        @if (rx.Medication != null && (rx.Status == "Dispensed" || rx.Status == "PartiallyDispensed"))
                                                        {
                                                            <div>
                                                                <span class="text-success fw-semibold"><i class="fa-solid fa-check me-1"></i>Dispensed: @(rx.Medication.DispensedQuantity?.ToString() ?? "Full")</span>
                                                                <div class="text-muted" style="font-size: 0.72rem;">
                                                                    By @(rx.Medication.Pharmacist != null ? $"{rx.Medication.Pharmacist.FirstName} {rx.Medication.Pharmacist.LastName}" : "Pharmacy")
                                                                    on @rx.Medication.DispensedDate.ToString("MM/dd HH:mm")
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted fst-italic">Awaiting dispensing</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 bg-light rounded text-muted small">
                                    <i class="fa-solid fa-prescription-bottle-medical fa-2x mb-2 text-secondary opacity-50"></i>
                                    <div>No previous prescriptions recorded.</div>
                                </div>
                            }
                        </div>

                        <!-- TAB 4: TRIAGE & ENCOUNTERS -->
                        <div class="tab-pane fade" id="tab-encounters" role="tabpanel">
                            @if (history?.Encounters != null && history.Encounters.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover table-sm align-middle mb-0">
                                        <thead class="table-light small text-uppercase text-muted">
                                            <tr>
                                                <th>Visit Date</th>
                                                <th>Type</th>
                                                <th>Workflow Status</th>
                                                <th>Attending Staff</th>
                                                <th>Triage Vital Signs</th>
                                                <th>Orders Summary</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var enc in history.Encounters)
                                            {
                                                var isStat = enc.Type == HUIOTClinicMS.Models.Enums.EncounterType.Emergency;
                                                <tr class="small @(isStat ? "table-danger bg-opacity-25" : "")">
                                                    <td>
                                                        <strong>@enc.StartTime.ToString("yyyy-MM-dd")</strong>
                                                        <div class="text-muted">@enc.StartTime.ToString("HH:mm")</div>
                                                    </td>
                                                    <td>
                                                        @if (isStat)
                                                        {
                                                            <span class="badge bg-danger"><i class="fa-solid fa-bolt me-1"></i>STAT Emergency</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-primary">Routine</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-secondary">@enc.Status</span>
                                                    </td>
                                                    <td>
                                                        @(enc.AssignedToStaff != null ? $"{enc.AssignedToStaff.FirstName} {enc.AssignedToStaff.LastName}" : "Unassigned")
                                                    </td>
                                                    <td>
                                                        @if (enc.TriageAssessment != null)
                                                        {
                                                            var tr = enc.TriageAssessment;
                                                            <div>
                                                                <span class="badge @(tr.PriorityLevel == "Emergency" ? "bg-danger" : (tr.PriorityLevel == "Urgent" ? "bg-warning text-dark" : "bg-info text-dark"))">
                                                                    @(tr.PriorityLevel ?? "Routine")
                                                                </span>
                                                                <div class="text-muted mt-1" style="font-size: 0.75rem;">
                                                                    @(tr.BloodPressure != null ? $"BP: {tr.BloodPressure} | " : "")
                                                                    @(tr.HeartRate != null ? $"HR: {tr.HeartRate} bpm | " : "")
                                                                    @(tr.Temperature != null ? $"T: {tr.Temperature}°C" : "")
                                                                    @(tr.Weight != null ? $" | Wt: {tr.Weight}kg" : "")
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted fst-italic">Pending Vitals</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-light text-dark border me-1">@enc.LabRequests.Count Lab(s)</span>
                                                        <span class="badge bg-light text-dark border">@enc.Prescriptions.Count Rx(s)</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 bg-light rounded text-muted small">
                                    <i class="fa-solid fa-heart-pulse fa-2x mb-2 text-secondary opacity-50"></i>
                                    <div>No previous visits or encounters recorded.</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (!Model.Any())
        {
            <div class="alert alert-warning border-warning shadow-sm mb-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h6 class="alert-heading mb-1"><i class="fa-solid fa-user-xmark text-warning me-1"></i> No Patient Record Found</h6>
                        <span class="small">No matching student found for identifier <strong>"@ViewBag.SearchTerm"</strong>. Please verify the physical ID card.</span>
                    </div>
                    @if (User.IsInRole("Nurse") || User.IsInRole("HealthOfficer"))
                    {
                        <a asp-action="Create" asp-route-idNumber="@ViewBag.SearchTerm" class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-user-plus me-1"></i> Register New Patient with ID: @ViewBag.SearchTerm
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>

<div class="clinic-card border-0 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <strong class="d-flex align-items-center text-dark fs-5">
            <i class="fa-solid fa-bed-pulse text-primary me-2"></i> Patient Directory
            <span class="badge bg-secondary bg-opacity-10 text-secondary ms-2 rounded-pill fs-6 fw-normal">@Model.Count()</span>
        </strong>
        <div>
            @if (User.IsInRole("Nurse") || User.IsInRole("HealthOfficer"))
            {
                <a asp-action="Create" class="btn btn-outline-primary btn-sm d-flex align-items-center shadow-sm">
                    <i class="fa-solid fa-user-plus me-2"></i> Direct New Patient Registration
                </a>
            }
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th class="fw-semibold py-2">Patient</th>
                    <th class="fw-semibold py-2">Identifiers</th>
                    <th class="fw-semibold py-2">Department</th>
                    <th class="fw-semibold py-2">Location</th>
                    <th class="fw-semibold py-2">Status</th>
                    <th class="fw-semibold py-2 text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @foreach (var item in Model)
                {
                    var initials = "";
                    if (!string.IsNullOrEmpty(item.FirstName)) initials += char.ToUpper(item.FirstName[0]);
                    if (!string.IsNullOrEmpty(item.LastName)) initials += char.ToUpper(item.LastName[0]);

                    <tr>
                        <td class="py-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center fw-bold me-3 flex-shrink-0" style="width: 40px; height: 40px; font-size: 0.9rem;">
                                    @(string.IsNullOrEmpty(initials) ? "?" : initials)
                                </div>
                                <div>
                                    <div class="fw-medium text-dark">@item.FirstName @item.LastName</div>
                                    <div class="small text-muted"><i class="fa-solid fa-venus-mars small me-1"></i> @item.Gender</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small fw-medium text-dark">ID: @item.IDNumber</div>
                            <div class="small text-muted">Card: @item.CardNumber</div>
                        </td>
                        <td>
                            <div class="text-truncate text-secondary" style="max-width: 150px;" title="@item.Department?.DepartmentName">
                                @(item.Department?.DepartmentName ?? "—")
                            </div>
                        </td>
                        <td>
                            <span class="small text-muted">
                                <i class="fa-solid fa-building me-1 opacity-50"></i> @(item.DormBlock?.BlockName ?? "—")
                            </span>
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 fw-normal"><i class="fa-solid fa-circle me-1" style="font-size: 0.5rem;"></i> Active</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1 fw-normal"><i class="fa-solid fa-circle me-1" style="font-size: 0.5rem;"></i> Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group shadow-sm">
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-light btn-sm text-info border" title="View Details">
                                    <i class="fa-regular fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-light btn-sm text-primary border" title="Edit Patient">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                @if (User.IsInRole("HealthOfficer"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-light btn-sm text-danger border" title="Delete Patient">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="fa-solid fa-hospital-user d-block fa-3x text-light mb-3"></i>
                            @(string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string) ? "No patients registered yet." : $"No patients match \"{ViewBag.SearchTerm}\".")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
