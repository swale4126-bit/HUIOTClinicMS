@model IEnumerable<HUIOTClinicMS.Models.Patient>
@{
    ViewData["Title"] = "Patient Records";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="clinic-card border-0 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <strong class="d-flex align-items-center text-dark fs-5">
            <i class="fa-solid fa-bed-pulse text-primary me-2"></i> Patient Records 
            <span class="badge bg-secondary bg-opacity-10 text-secondary ms-2 rounded-pill fs-6 fw-normal">@Model.Count()</span>
        </strong>
        <div class="d-flex gap-2 flex-wrap">
            <form method="get" class="d-flex">
                <div class="input-group input-group-sm shadow-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Search by ID or Name..." style="min-width:220px;" />
                    <button type="submit" class="btn btn-primary px-3">Search</button>
                </div>
            </form>
            <a asp-action="Create" class="btn btn-primary btn-sm d-flex align-items-center shadow-sm">
                <i class="fa-solid fa-user-plus me-2"></i> Register Patient
            </a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th class="fw-semibold py-2">Patient</th>
                    <th class="fw-semibold py-2">Identifiers</th>
                    <th class="fw-semibold py-2">Department</th>
                    <th class="fw-semibold py-2">Location</th>
                    <th class="fw-semibold py-2">Status</th>
                    <th class="fw-semibold py-2 text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @foreach (var item in Model)
                {
                    var initials = "";
                    if (!string.IsNullOrEmpty(item.FirstName)) initials += char.ToUpper(item.FirstName[0]);
                    if (!string.IsNullOrEmpty(item.LastName)) initials += char.ToUpper(item.LastName[0]);

                    <tr>
                        <td class="py-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center fw-bold me-3 flex-shrink-0" style="width: 40px; height: 40px; font-size: 0.9rem;">
                                    @(string.IsNullOrEmpty(initials) ? "?" : initials)
                                </div>
                                <div>
                                    <div class="fw-medium text-dark">@item.FirstName @item.LastName</div>
                                    <div class="small text-muted"><i class="fa-solid fa-venus-mars small me-1"></i> @item.Gender</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small fw-medium text-dark">ID: @item.IDNumber</div>
                            <div class="small text-muted">Card: @item.CardNumber</div>
                        </td>
                        <td>
                            <div class="text-truncate text-secondary" style="max-width: 150px;" title="@item.Department?.DepartmentName">
                                @(item.Department?.DepartmentName ?? "—")
                            </div>
                        </td>
                        <td>
                            <span class="small text-muted">
                                <i class="fa-solid fa-building me-1 opacity-50"></i> @(item.DormBlock?.BlockName ?? "—")
                            </span>
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 fw-normal"><i class="fa-solid fa-circle me-1" style="font-size: 0.5rem;"></i> Active</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1 fw-normal"><i class="fa-solid fa-circle me-1" style="font-size: 0.5rem;"></i> Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group shadow-sm">
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-light btn-sm text-info border" title="View Details">
                                    <i class="fa-regular fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-light btn-sm text-primary border" title="Edit Patient">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                @if (User.IsInRole("HealthOfficer"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-light btn-sm text-danger border" title="Delete Patient">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="fa-solid fa-hospital-user d-block fa-3x text-light mb-3"></i>
                            @(string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string) ? "No patients registered yet." : $"No patients match \"{ViewBag.SearchTerm}\".")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
