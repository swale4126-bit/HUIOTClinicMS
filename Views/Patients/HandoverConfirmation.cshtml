@model HUIOTClinicMS.ViewModels.PatientHandoverConfirmationViewModel
@{
    ViewData["Title"] = "Handover Confirmation";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        @if (Model.IsEmergency)
        {
            <div class="alert alert-danger border-danger shadow-sm mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-1 text-danger">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <h4 class="alert-heading mb-1 text-danger fw-bold">
                            <i class="fa-solid fa-bolt me-1"></i> STAT Emergency Handover Dispatched
                        </h4>
                        <p class="mb-0 small fw-semibold">
                            Urgent emergency alerts were dispatched immediately to Destination Nurse <strong>@Model.DestinationNurseName</strong> and all on-duty Health Officers.
                        </p>
                    </div>
                </div>
                <hr class="my-2" />
                <div class="small text-danger-emphasis">
                    <i class="fa-solid fa-circle-exclamation me-1"></i>
                    <strong>CRITICAL CLINICAL NOTICE:</strong> Notification dispatch does not constitute start of medical treatment. Ensure immediate physical escort of the student to the triage / resuscitation station. Do not leave the patient unattended.
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-success border-success shadow-sm mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-1 text-success">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div>
                        <h4 class="alert-heading mb-1 text-success fw-bold">Patient Handover Dispatched Successfully</h4>
                        <p class="mb-0 small text-muted">
                            Destination Nurse <strong>@Model.DestinationNurseName</strong> has been notified. Administrative registration is complete.
                        </p>
                    </div>
                </div>
            </div>
        }

        <!-- Handover Details Card -->
        <div class="clinic-card border-0 shadow-sm mb-4">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <strong class="text-dark small text-uppercase">
                    <i class="fa-solid fa-file-invoice text-primary me-1"></i> Handover Record #@Model.HandoverID
                </strong>
                @if (Model.IsEmergency)
                {
                    <span class="badge bg-danger px-3 py-1">
                        <i class="fa-solid fa-bolt me-1"></i> STAT Emergency
                    </span>
                }
                else
                {
                    <span class="badge bg-primary px-3 py-1">
                        <i class="fa-solid fa-clock me-1"></i> Routine Handover
                    </span>
                }
            </div>

            <!-- Student Demographics -->
            <div class="row g-3 mb-3 small">
                <div class="col-sm-6">
                    <span class="text-muted d-block">Student Name</span>
                    <strong class="fs-6 text-dark">@Model.PatientName</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Clinic Card Number</span>
                    <strong class="fs-6 text-primary">@(Model.CardNumber ?? "—")</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">University ID Number</span>
                    <span class="fw-semibold">@Model.IDNumber</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Department & Campus Block</span>
                    <span>@(Model.DepartmentName ?? "—") &bull; @(Model.DormBlockName ?? "—")</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.TokenNumber))
            {
                <div class="p-3 mb-3 bg-primary bg-opacity-10 rounded border border-primary border-opacity-25 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-primary small fw-semibold text-uppercase d-block">Triage Queue Token Issued</span>
                        <strong class="fs-4 text-primary"><i class="fa-solid fa-ticket me-1"></i> @Model.TokenNumber</strong>
                    </div>
                    <span class="badge bg-primary px-3 py-2 fs-6">Active in Triage Queue</span>
                </div>
            }

            <hr class="my-2" />

            <!-- Routing Details -->
            <div class="row g-3 my-1 small">
                <div class="col-sm-6">
                    <span class="text-muted d-block">Assigned Destination Nurse</span>
                    <strong class="text-dark"><i class="fa-solid fa-user-nurse text-primary me-1"></i> @Model.DestinationNurseName</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Registration Nurse (Origin)</span>
                    <span class="text-secondary"><i class="fa-solid fa-id-card text-muted me-1"></i> @Model.OriginNurseName</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Dispatch Timestamp</span>
                    <span class="text-dark"><i class="fa-regular fa-clock me-1"></i> @Model.HandoverTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Current Workflow Status</span>
                    <span class="badge bg-light text-dark border">
                        <i class="fa-solid fa-hourglass-half text-warning me-1"></i> @Model.StatusMessage
                    </span>
                </div>
            </div>
        </div>

        <!-- Only Two Actions Allowed -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-2">
            <a asp-action="Index" class="btn btn-primary px-4 py-2 shadow-sm fw-semibold">
                <i class="fa-solid fa-user-plus me-2"></i> Register Another Patient / Search Desk
            </a>
            <a asp-controller="Nurse" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                <i class="fa-solid fa-table-columns me-2"></i> Return to Dashboard
            </a>
        </div>
    </div>
</div>
