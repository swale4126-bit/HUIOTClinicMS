@model HUIOTClinicMS.Models.Patient
@{
    ViewData["Title"] = "Delete Patient";
}

<h2 class="mb-4">Delete Patient</h2>

<div class="clinic-card mb-3">
    <p class="text-danger fw-semibold">
        Are you sure you want to delete this patient record? You can only delete 
        patients who have no clinical history (medical records, lab requests, etc.). 
        If the patient has clinical history, you should Edit and deactivate them instead. 
        This cannot be undone.
    </p>

    <dl class="row mb-0">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

        <dt class="col-sm-3">Card Number</dt>
        <dd class="col-sm-9">@Model.CardNumber</dd>

        <dt class="col-sm-3">Department</dt>
        <dd class="col-sm-9">@(Model.Department?.DepartmentName ?? "—")</dd>

        <dt class="col-sm-3">Dorm Block</dt>
        <dd class="col-sm-9">@(Model.DormBlock?.BlockName ?? "—")</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
</form>