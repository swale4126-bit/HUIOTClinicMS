@model HUIOTClinicMS.ViewModels.UserListItemViewModel
@{
    ViewData["Title"] = "Delete User";
}

<h2 class="mb-4">Delete User</h2>

<div class="clinic-card mb-3">
    <p class="text-danger fw-semibold">Are you sure you want to delete this account? This cannot be undone.</p>
    <dl class="row mb-0">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9">@Model.Role</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
</form>