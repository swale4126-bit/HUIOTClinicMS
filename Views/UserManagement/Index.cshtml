@model List<HUIOTClinicMS.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "User Management";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="clinic-card">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <strong>All Users (@Model.Count)</strong>
        <div class="d-flex gap-2 flex-wrap">
            <form method="get" class="d-flex">
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Search by staff name..." style="min-width:200px;" />
                <button type="submit" class="btn btn-outline-primary btn-sm ms-2"><i class="fa-solid fa-magnifying-glass"></i></button>
            </form>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-user-plus me-1"></i> Add User
            </a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.FullName</td>
                        <td class="small text-muted">@u.Email</td>
                        <td>@u.Role</td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge badge-status-active">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-status-inactive">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-outline-primary btn-sm text-danger">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted small py-3">
                            @(string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string) ? "No users found." : $"No users match \"{ViewBag.SearchTerm}\".")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
