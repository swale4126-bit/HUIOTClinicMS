@model HUIOTClinicMS.Models.ClinicalEncounter
@{
    ViewData["Title"] = $"Encounter #{Model.ID} - {Model.Patient?.FirstName} {Model.Patient?.LastName}";
    var labResults = ViewBag.LabResults as List<HUIOTClinicMS.Models.LabResult> ?? new List<HUIOTClinicMS.Models.LabResult>();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-info me-2"></i>@TempData["InfoMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">
            Encounter #@Model.ID: @Model.Patient?.FirstName @Model.Patient?.LastName
        </h2>
        <span class="text-muted small">
            Card: <strong>@(Model.Patient?.CardNumber ?? "—")</strong> | 
            ID: <strong>@(Model.Patient?.IDNumber ?? "—")</strong> | 
            Dept: <strong>@(Model.Patient?.Department?.DepartmentName ?? "—")</strong> | 
            Started: <strong>@Model.StartTime.ToString("MMM dd, yyyy HH:mm")</strong>
        </span>
        <div class="mt-2">
            <span class="badge bg-light text-dark border">
                <i class="fa-solid fa-user-doctor me-1 text-primary"></i>
                Assigned Clinician: <strong>@(Model.AssignedToStaff != null ? $"{Model.AssignedToStaff.FirstName} {Model.AssignedToStaff.LastName} ({Model.AssignedToStaff.Role})" : "Unassigned / General Queue")</strong>
            </span>
            @if (Model.Status != HUIOTClinicMS.Models.Enums.WorkflowState.Discharged && (User.IsInRole("HealthOfficer") || User.IsInRole("Nurse")))
            {
                <a asp-controller="TaskAssignment" asp-action="Reassign" asp-route-taskType="PatientEncounter" asp-route-taskId="@Model.ID" class="btn btn-outline-primary btn-sm ms-1 py-0 px-2" style="font-size: 0.75rem;">
                    <i class="fa-solid fa-arrows-rotate me-1"></i>Reassign
                </a>
            }
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge @(Model.Type == HUIOTClinicMS.Models.Enums.EncounterType.Emergency ? "bg-danger fs-6" : "bg-secondary")">
            <i class="fa-solid @(Model.Type == HUIOTClinicMS.Models.Enums.EncounterType.Emergency ? "fa-truck-medical" : "fa-calendar-check") me-1"></i>@Model.Type
        </span>
        <span class="badge @(Model.Status == HUIOTClinicMS.Models.Enums.WorkflowState.InEmergency ? "bg-danger fs-6" : Model.Status == HUIOTClinicMS.Models.Enums.WorkflowState.Discharged ? "bg-success" : "bg-primary")">
            @Model.Status
        </span>
        @if (Model.Status != HUIOTClinicMS.Models.Enums.WorkflowState.Discharged && Model.Status != HUIOTClinicMS.Models.Enums.WorkflowState.Transferred && (User.IsInRole("HealthOfficer") || User.IsInRole("Nurse")))
        {
            <form asp-action="Discharge" asp-route-id="@Model.ID" method="post" class="d-inline" onsubmit="return confirm('Conclude and discharge this clinical encounter?');">
                <button type="submit" class="btn btn-sm btn-outline-success">
                    <i class="fa-solid fa-check-double me-1"></i> Conclude & Discharge
                </button>
            </form>
        }
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- 1. Triage Assessment & Vitals -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
                <strong class="text-primary"><i class="fa-solid fa-heart-pulse me-2"></i>1. Triage & Objective Vital Signs</strong>
                @if (Model.TriageAssessment == null && Model.Status != HUIOTClinicMS.Models.Enums.WorkflowState.Discharged && (User.IsInRole("HealthOfficer") || User.IsInRole("Nurse")))
                {
                    <a asp-controller="TriageAssessments" asp-action="Create" asp-route-encounterId="@Model.ID" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-plus me-1"></i> Record Vitals
                    </a>
                }
            </div>
            <div class="card-body">
                @if (Model.TriageAssessment != null)
                {
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <span class="text-muted small d-block">Blood Pressure</span>
                            <strong>@(Model.TriageAssessment.BloodPressure ?? "—")</strong>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-muted small d-block">Heart Rate</span>
                            <strong>@(Model.TriageAssessment.HeartRate?.ToString() ?? "—") bpm</strong>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-muted small d-block">Temperature</span>
                            <strong>@(Model.TriageAssessment.Temperature?.ToString() ?? "—") °C</strong>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-muted small d-block">Weight</span>
                            <strong>@(Model.TriageAssessment.Weight?.ToString() ?? "—") kg</strong>
                        </div>
                        <div class="col-12 border-top pt-2 mt-2">
                            <span class="text-muted small d-block">Priority Level:</span>
                            <span class="badge @(Model.TriageAssessment.PriorityLevel == "Emergency" ? "bg-danger" : Model.TriageAssessment.PriorityLevel == "Urgent" ? "bg-warning text-dark" : "bg-info text-dark")">
                                @(Model.TriageAssessment.PriorityLevel ?? "Routine")
                            </span>
                            @if (!string.IsNullOrEmpty(Model.TriageAssessment.Notes))
                            {
                                <span class="ms-2 text-muted small">Notes: @Model.TriageAssessment.Notes</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0 small">No triage vitals documented for this visit.</p>
                }
            </div>
        </div>

        <!-- 2. Clinical Notes & SOAP Assessments -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
                <strong class="text-primary"><i class="fa-solid fa-user-doctor me-2"></i>2. Clinical Notes & Consultation</strong>
                @if (Model.Status != HUIOTClinicMS.Models.Enums.WorkflowState.Discharged && (User.IsInRole("HealthOfficer") || User.IsInRole("Nurse")))
                {
                    <a asp-controller="MedicalRecords" asp-action="Create" asp-route-encounterId="@Model.ID" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-plus me-1"></i> Add Clinical Note
                    </a>
                }
            </div>
            <div class="card-body">
                @if (Model.ClinicalNotes.Any())
                {
                    @foreach (var note in Model.ClinicalNotes.OrderByDescending(n => n.DateTime))
                    {
                        <div class="mb-3 p-3 bg-light rounded border">
                            <div class="d-flex justify-content-between mb-2">
                                <strong class="text-dark">Diagnosis: @(note.Diagnosis ?? "Under evaluation")</strong>
                                <small class="text-muted">@note.DateTime.ToString("MMM dd, yyyy HH:mm")</small>
                            </div>
                            <div class="small mb-1"><strong>Chief Complaint:</strong> @note.ChiefComplaint</div>
                            @if (!string.IsNullOrEmpty(note.GeneralAppearance))
                            {
                                <div class="small mb-1"><strong>Appearance:</strong> @note.GeneralAppearance</div>
                            }
                            @if (!string.IsNullOrEmpty(note.Treatment))
                            {
                                <div class="small mb-1"><strong>Treatment Plan:</strong> @note.Treatment</div>
                            }
                            @if (!string.IsNullOrEmpty(note.Notes))
                            {
                                <div class="small mb-1 text-secondary"><strong>Notes:</strong> @note.Notes</div>
                            }
                            <div class="small text-muted border-top pt-1 mt-2">
                                Authored by: @(note.CreatedByStaff != null ? $"{note.CreatedByStaff.FirstName} {note.CreatedByStaff.LastName}" : (note.CreatedBy ?? "Clinician"))
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0 small">No consultation notes recorded yet.</p>
                }
            </div>
        </div>

        <!-- 3. Laboratory Diagnostic Activity -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
                <strong class="text-primary"><i class="fa-solid fa-flask-vial me-2"></i>3. Laboratory Diagnostics</strong>
                @if (Model.Status != HUIOTClinicMS.Models.Enums.WorkflowState.Discharged && (User.IsInRole("HealthOfficer") || User.IsInRole("Nurse")))
                {
                    <a asp-controller="LabRequests" asp-action="Create" asp-route-encounterId="@Model.ID" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-plus me-1"></i> Request Tests
                    </a>
                }
            </div>
            <div class="card-body">
                @if (Model.LabRequests.Any())
                {
                    @foreach (var req in Model.LabRequests)
                    {
                        <div class="p-3 mb-2 border rounded">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>Request #@req.LabRequestID (@req.RequestDate.ToString("MMM dd HH:mm"))</strong>
                                <div class="d-flex align-items-center gap-2">
                                    @if (req.Status != "Completed" && (User.IsInRole("LabTechnician") || User.IsInRole("HealthOfficer")))
                                    {
                                        <a asp-controller="LabResults" asp-action="Create" asp-route-labRequestId="@req.LabRequestID" class="btn btn-sm btn-primary py-0 px-2 shadow-sm">
                                            <i class="fa-solid fa-flask-vial me-1"></i> Enter Results & Handover
                                        </a>
                                    }
                                    <span class="badge @(req.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@req.Status</span>
                                </div>
                            </div>
                            <div class="small mb-1">
                                Tests: @string.Join(", ", req.TestTypes.Select(t => t.TestName))
                            </div>
                            <div class="small mb-2">
                                <span class="text-muted">Assigned Tech:</span>
                                <strong>@(req.AssignedToStaff != null ? $"{req.AssignedToStaff.FirstName} {req.AssignedToStaff.LastName}" : "Unassigned (General Queue)")</strong>
                                @if (req.Status != "Completed" && (User.IsInRole("HealthOfficer") || User.IsInRole("Nurse") || User.IsInRole("LabTechnician")))
                                {
                                    <a asp-controller="TaskAssignment" asp-action="Reassign" asp-route-taskType="LabRequest" asp-route-taskId="@req.LabRequestID" class="badge bg-light text-primary border text-decoration-none ms-2">
                                        <i class="fa-solid fa-user-pen me-1"></i>Reassign
                                    </a>
                                }
                            </div>
                            @if (labResults.Any())
                            {
                                <div class="border-top pt-2 mt-2">
                                    <strong class="small d-block mb-1 text-secondary">Results:</strong>
                                    <ul class="list-unstyled mb-0 small">
                                        @foreach (var res in labResults)
                                        {
                                            <li>
                                                <i class="fa-solid fa-check text-success me-1"></i>
                                                <strong>@(res.TestType?.TestName ?? "Test"):</strong> @res.Result
                                                @if (!string.IsNullOrEmpty(res.Remark))
                                                {
                                                    <span class="text-muted">(@res.Remark)</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0 small">No diagnostic laboratory testing ordered for this encounter.</p>
                }
            </div>
        </div>

        <!-- 4. Prescriptions & Pharmacy Dispensing -->
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
                <strong class="text-primary"><i class="fa-solid fa-prescription-bottle-medical me-2"></i>4. Prescriptions & Dispensing</strong>
                @if (Model.Status != HUIOTClinicMS.Models.Enums.WorkflowState.Discharged && (User.IsInRole("HealthOfficer") || User.IsInRole("Nurse")))
                {
                    <a asp-controller="Prescriptions" asp-action="Create" asp-route-encounterId="@Model.ID" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-plus me-1"></i> Authorize Prescription
                    </a>
                }
            </div>
            <div class="card-body">
                @if (Model.Prescriptions.Any())
                {
                    @foreach (var rx in Model.Prescriptions)
                    {
                        <div class="p-3 mb-2 border rounded">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>Directives: @rx.RX</strong>
                                <span class="badge @(rx.Status == "Dispensed" ? "bg-success" : rx.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark")">
                                    @rx.Status
                                </span>
                            </div>
                            <div class="small text-muted mb-1">
                                Prescribed on @rx.TimeDate.ToString("MMM dd, yyyy HH:mm") by @(rx.PrescribedBy != null ? $"{rx.PrescribedBy.FirstName} {rx.PrescribedBy.LastName}" : "Clinician")
                            </div>
                            <div class="small mb-1">
                                <span class="text-muted">Assigned Pharmacist:</span>
                                <strong>@(rx.AssignedToStaff != null ? $"{rx.AssignedToStaff.FirstName} {rx.AssignedToStaff.LastName}" : "Unassigned (General Queue)")</strong>
                                @if (rx.Status == "Pending" && (User.IsInRole("HealthOfficer") || User.IsInRole("Nurse") || User.IsInRole("Pharmacist")))
                                {
                                    <a asp-controller="TaskAssignment" asp-action="Reassign" asp-route-taskType="Prescription" asp-route-taskId="@rx.PrescriptionID" class="badge bg-light text-primary border text-decoration-none ms-2">
                                        <i class="fa-solid fa-user-pen me-1"></i>Reassign
                                    </a>
                                }
                            </div>
                            @if (rx.Medication != null)
                            {
                                <div class="bg-light p-2 rounded small border mt-2">
                                    <i class="fa-solid fa-pills text-success me-1"></i>
                                    <strong>Dispensed:</strong> @rx.Medication.MedicationName (@(rx.Medication.DispensedQuantity?.ToString() ?? "—") units) on @rx.Medication.DispensedDate.ToString("MMM dd HH:mm")
                                    @if (!string.IsNullOrEmpty(rx.Medication.Remark))
                                    {
                                        <div class="text-muted mt-1">Counseling: @rx.Medication.Remark</div>
                                    }
                                </div>
                            }
                            else if (rx.Status == "Pending" && User.IsInRole("Pharmacist"))
                            {
                                <a asp-controller="Prescriptions" asp-action="Dispense" asp-route-id="@rx.PrescriptionID" class="btn btn-sm btn-success mt-2">
                                    <i class="fa-solid fa-hand-holding-medical me-1"></i> Dispense Medication
                                </a>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0 small">No prescriptions issued for this encounter.</p>
                }
            </div>
        </div>
    </div>

    <!-- Right Sidebar: Referral, Emergency & Patient Overview -->
    <div class="col-lg-4">
        <!-- Referral / Transfer Status -->
        <div class="card mb-3 shadow-sm border-warning">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center py-2">
                <strong><i class="fa-solid fa-ambulance me-1"></i> Hospital Referral / Handover</strong>
            </div>
            <div class="card-body">
                @if (Model.ReferralRecord != null)
                {
                    <div class="alert alert-danger py-2 mb-2">
                        <strong>Transferred to:</strong> @Model.ReferralRecord.DestinationFacility
                    </div>
                    <div class="small mb-1"><strong>Reason:</strong> @Model.ReferralRecord.ReasonForTransfer</div>
                    @if (!string.IsNullOrEmpty(Model.ReferralRecord.ClinicalSummary))
                    {
                        <div class="small mb-1"><strong>Summary:</strong> @Model.ReferralRecord.ClinicalSummary</div>
                    }
                    <div class="small text-muted mt-2 border-top pt-1">
                        Transferred by: @(Model.ReferralRecord.TransferredBy ?? Model.ReferralRecord.CreatedBy ?? "Clinician") at @Model.ReferralRecord.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                    </div>
                    <a asp-controller="ReferralRecords" asp-action="PrintLetter" asp-route-id="@Model.ReferralRecord.ID" target="_blank" class="btn btn-danger w-100 btn-sm shadow-sm mt-3 fw-semibold">
                        <i class="fa-solid fa-print me-1"></i> Print / Download Referral Letter (PDF)
                    </a>
                }
                else
                {
                    <p class="small text-muted mb-3">If patient condition exceeds clinic resources, initiate inter-facility transfer to tertiary care (HUCSH).</p>
                    @if (Model.Status != HUIOTClinicMS.Models.Enums.WorkflowState.Discharged && (User.IsInRole("HealthOfficer") || User.IsInRole("Nurse")))
                    {
                        <a asp-controller="ReferralRecords" asp-action="Create" asp-route-encounterId="@Model.ID" class="btn btn-warning w-100 btn-sm fw-semibold shadow-sm">
                            <i class="fa-solid fa-ambulance me-1"></i> Initiate Hospital Referral & Transfer
                        </a>
                    }
                }
            </div>
        </div>

        <!-- Patient Demographics Card -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white py-3 border-bottom">
                <strong class="text-dark"><i class="fa-solid fa-id-card me-2"></i>Patient Profile</strong>
            </div>
            <div class="card-body small">
                <div class="mb-2"><strong>Gender:</strong> @(Model.Patient?.Gender ?? "—")</div>
                <div class="mb-2"><strong>Date of Birth:</strong> @(Model.Patient?.DateOfBirth.ToString("yyyy-MM-dd") ?? "—")</div>
                <div class="mb-2"><strong>Phone:</strong> @(Model.Patient?.PhoneNumber ?? "—")</div>
                <div class="mb-2"><strong>Dorm Block:</strong> @(Model.Patient?.DormBlock?.BlockName ?? "—")</div>
                <div class="border-top pt-2 mt-2">
                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientID" class="btn btn-outline-primary btn-sm w-100">
                        <i class="fa-solid fa-clock-rotate-left me-1"></i> Full Clinical History
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&lsaquo; Back to Encounters List</a>
</div>
