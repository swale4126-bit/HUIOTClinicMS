@model HUIOTClinicMS.ViewModels.PharmacistDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="clinic-card">
            <div class="clinic-metric-value">@Model.PrescriptionsToday</div>
            <div class="clinic-metric-label">Prescriptions Today</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clinic-card">
            <div class="clinic-metric-value">@Model.TotalMedicationsInRegistry</div>
            <div class="clinic-metric-label">Medications in Registry</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clinic-card">
            <div class="clinic-metric-value">@Model.TotalPrescriptions</div>
            <div class="clinic-metric-label">Total Prescriptions</div>
        </div>
    </div>
</div>

<div class="clinic-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <strong>Recent Prescriptions</strong>
        <a asp-controller="Prescriptions" asp-action="Index" class="small text-decoration-none">View All &rsaquo;</a>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>Patient</th>
                    <th>Rx</th>
                    <th>Prescribed By</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rx in Model.RecentPrescriptions)
                {
                    var badgeClass = rx.Status == "Dispensed" ? "badge-status-completed" : "badge-status-pending";
                    <tr>
                        <td>@(rx.Patient != null ? $"{rx.Patient.FirstName} {rx.Patient.LastName}" : "—")</td>
                        <td class="small text-muted">@rx.RX</td>
                        <td class="small">@(rx.PrescribedBy != null ? $"{rx.PrescribedBy.FirstName} {rx.PrescribedBy.LastName}" : "—")</td>
                        <td class="small text-muted">@rx.TimeDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge @badgeClass">@rx.Status</span></td>
                        <td>
                            <a asp-controller="Prescriptions" asp-action="Details" asp-route-id="@rx.PrescriptionID" class="btn btn-outline-primary btn-sm">View</a>
                            @if (rx.Status == "Pending")
                            {
                                <a asp-controller="Prescriptions" asp-action="Dispense" asp-route-id="@rx.PrescriptionID" class="btn btn-primary btn-sm">Dispense</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.RecentPrescriptions.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted small py-3">No prescriptions yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>