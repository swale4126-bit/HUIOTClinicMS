@model HUIOTClinicMS.ViewModels.PharmacistDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-file-prescription fs-4"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">@Model.PrescriptionsToday</h3>
            <small class="text-muted fw-medium text-uppercase" style="letter-spacing: 0.5px;">Prescriptions Today</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
            <div class="bg-info bg-opacity-10 text-info rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-pills fs-4"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">@Model.TotalMedicationsInRegistry</h3>
            <small class="text-muted fw-medium text-uppercase" style="letter-spacing: 0.5px;">Medications in Registry</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
            <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-check-double fs-4"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">@Model.TotalPrescriptions</h3>
            <small class="text-muted fw-medium text-uppercase" style="letter-spacing: 0.5px;">Total Prescriptions</small>
        </div>
    </div>
</div>

<div class="clinic-card border-0 shadow-sm mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3">
        <strong class="d-flex align-items-center text-dark fs-5">
            <i class="fa-solid fa-prescription text-primary me-2"></i> Recent Prescriptions
        </strong>
        <a asp-controller="Prescriptions" asp-action="Index" class="btn btn-outline-primary btn-sm shadow-sm">View All &rsaquo;</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th class="fw-semibold py-2">Patient</th>
                    <th class="fw-semibold py-2">Rx</th>
                    <th class="fw-semibold py-2">Prescribed By</th>
                    <th class="fw-semibold py-2">Date</th>
                    <th class="fw-semibold py-2">Status</th>
                    <th class="fw-semibold py-2 text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @foreach (var rx in Model.RecentPrescriptions)
                {
                    <tr>
                        <td class="fw-medium text-dark py-2">@(rx.Patient != null ? $"{rx.Patient.FirstName} {rx.Patient.LastName}" : "—")</td>
                        <td class="small text-secondary py-2 text-truncate" style="max-width: 180px;" title="@rx.RX">@rx.RX</td>
                        <td class="small text-muted py-2">@(rx.PrescribedBy != null ? $"{rx.PrescribedBy.FirstName} {rx.PrescribedBy.LastName}" : "—")</td>
                        <td class="small text-muted py-2">@rx.TimeDate.ToString("yyyy-MM-dd")</td>
                        <td class="py-2">
                            @if (rx.Status == "Dispensed")
                            {
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1"><i class="fa-solid fa-circle me-1" style="font-size: 0.5rem;"></i> Dispensed</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1"><i class="fa-solid fa-circle me-1" style="font-size: 0.5rem;"></i> Pending</span>
                            }
                        </td>
                        <td class="text-end py-2">
                            <div class="btn-group shadow-sm">
                                <a asp-controller="Prescriptions" asp-action="Details" asp-route-id="@rx.PrescriptionID" class="btn btn-light btn-sm text-info border" title="View Prescription">
                                    <i class="fa-regular fa-eye"></i>
                                </a>
                                @if (rx.Status == "Pending")
                                {
                                    <a asp-controller="Prescriptions" asp-action="Dispense" asp-route-id="@rx.PrescriptionID" class="btn btn-light btn-sm text-success border" title="Dispense">
                                        <i class="fa-solid fa-hand-holding-medical"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.RecentPrescriptions.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4"><i class="fa-solid fa-prescription-bottle d-block fa-2x text-light mb-2"></i> No prescriptions yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>