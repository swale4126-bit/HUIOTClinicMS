@model HUIOTClinicMS.ViewModels.NurseDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-user-plus fs-4"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">@Model.PatientsRegisteredToday</h3>
            <small class="text-muted fw-medium text-uppercase" style="letter-spacing: 0.5px;">Registered Today</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
            <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-clipboard-list fs-4"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">@Model.PendingTriage</h3>
            <small class="text-muted fw-medium text-uppercase" style="letter-spacing: 0.5px;">Pending Medical Record</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
            <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-file-medical fs-4"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">@Model.TotalRecords</h3>
            <small class="text-muted fw-medium text-uppercase" style="letter-spacing: 0.5px;">Total Records</small>
        </div>
    </div>
</div>

<div class="clinic-card border-0 shadow-sm mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3">
        <strong class="d-flex align-items-center text-dark fs-5">
            <i class="fa-solid fa-users-line text-primary me-2"></i> Patient Queue
        </strong>
        <a asp-controller="Patients" asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
            <i class="fa-solid fa-user-plus me-1"></i> Register New Patient
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th class="fw-semibold py-2">Patient Name</th>
                    <th class="fw-semibold py-2">Card No.</th>
                    <th class="fw-semibold py-2">Department</th>
                    <th class="fw-semibold py-2">Time In</th>
                    <th class="fw-semibold py-2">Status</th>
                    <th class="fw-semibold py-2 text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @foreach (var item in Model.TodaysQueue)
                {
                    <tr>
                        <td class="fw-medium text-dark py-2">@item.FullName</td>
                        <td class="small text-muted py-2">@item.CardNumber</td>
                        <td class="py-2 text-truncate text-secondary" style="max-width:150px;" title="@item.DepartmentName">@item.DepartmentName</td>
                        <td class="small text-muted py-2">@item.TimeIn.ToString("MMM dd, yyyy")</td>
                        <td class="py-2">
                            @if (item.QueueType == "Result Review")
                            {
                                <span class="badge rounded-pill bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">Result Review</span>
                            }
                            else if (item.HasMedicalRecordToday)
                            {
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1"><i class="fa-solid fa-circle me-1" style="font-size: 0.5rem;"></i> Completed</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1"><i class="fa-solid fa-circle me-1" style="font-size: 0.5rem;"></i> Pending</span>
                            }
                        </td>
                        <td class="text-end py-2">
                            <div class="btn-group shadow-sm">
                                <a asp-controller="Patients" asp-action="Details" asp-route-id="@item.PatientID" class="btn btn-light btn-sm text-info border" title="View Patient">
                                    <i class="fa-regular fa-eye"></i>
                                </a>
                                @if (item.QueueType == "Result Review")
                                {
                                    <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@item.MedicalRecordIDToday" class="btn btn-light btn-sm text-primary border" title="View Record">
                                        <i class="fa-solid fa-file-medical"></i>
                                    </a>
                                }
                                else if (!item.HasMedicalRecordToday)
                                {
                                    <a asp-controller="MedicalRecords" asp-action="Create" asp-route-patientId="@item.PatientID" class="btn btn-light btn-sm text-primary border" title="Add Medical Record">
                                        <i class="fa-solid fa-file-circle-plus"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="LabRequests" asp-action="Create" asp-route-medicalRecordId="@item.MedicalRecordIDToday" class="btn btn-light btn-sm text-warning border" title="Request Lab Test">
                                        <i class="fa-solid fa-flask"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.TodaysQueue.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="fa-solid fa-mug-hot d-block fa-2x text-light mb-2"></i> No patients registered yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="clinic-card border-0 shadow-sm mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3">
        <strong class="d-flex align-items-center text-dark fs-5">
            <i class="fa-solid fa-microscope text-warning me-2"></i> Recent Lab Results (Needs Prescription)
        </strong>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th class="fw-semibold py-2">Patient</th>
                    <th class="fw-semibold py-2">Test Type(s)</th>
                    <th class="fw-semibold py-2">Result(s)</th>
                    <th class="fw-semibold py-2">Status</th>
                    <th class="fw-semibold py-2 text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @foreach (var group in Model.RecentGroupedLabResults)
                {
                    <tr>
                        <td class="fw-medium text-dark py-2">@(group.Patient != null ? $"{group.Patient.FirstName} {group.Patient.LastName}" : "—")</td>
                        <td class="small py-2 text-secondary">
                            @foreach (var res in group.Results)
                            {
                                <div><i class="fa-solid fa-flask text-primary opacity-75 me-1"></i> @(res.TestType?.TestName ?? "—")</div>
                            }
                        </td>
                        <td class="small text-muted py-2">
                            @foreach (var res in group.Results)
                            {
                                <div><strong class="text-dark">@res.Result</strong> @(string.IsNullOrEmpty(res.Remark) ? "" : $"({res.Remark})")</div>
                            }
                        </td>
                        <td class="py-2"><span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1"><i class="fa-solid fa-circle me-1" style="font-size: 0.5rem;"></i> Completed</span></td>
                        <td class="text-end py-2">
                            <div class="btn-group shadow-sm">
                                <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@group.MedicalRecordID" class="btn btn-light btn-sm text-primary border" title="View Record">
                                    <i class="fa-regular fa-file-lines"></i>
                                </a>
                                <a asp-controller="Prescriptions" asp-action="Create" asp-route-labResultId="@group.PrimaryLabResultID" class="btn btn-light btn-sm text-success border" title="Prescribe">
                                    <i class="fa-solid fa-prescription-bottle-medical"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.RecentGroupedLabResults.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="fa-solid fa-check-double d-block fa-2x text-light mb-2"></i> No pending lab results to prescribe.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="clinic-card border-0 shadow-sm mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3">
        <strong class="d-flex align-items-center text-dark fs-5">
            <i class="fa-solid fa-prescription-bottle text-success me-2"></i> Prescribed Patients
        </strong>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th class="fw-semibold py-2">Patient</th>
                    <th class="fw-semibold py-2">Test Type(s)</th>
                    <th class="fw-semibold py-2">Result(s)</th>
                    <th class="fw-semibold py-2">Status</th>
                    <th class="fw-semibold py-2 text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @foreach (var group in Model.PrescribedPatients)
                {
                    <tr>
                        <td class="fw-medium text-dark py-2">@(group.Patient != null ? $"{group.Patient.FirstName} {group.Patient.LastName}" : "—")</td>
                        <td class="small py-2 text-secondary">
                            @foreach (var res in group.Results)
                            {
                                <div><i class="fa-solid fa-flask text-primary opacity-75 me-1"></i> @(res.TestType?.TestName ?? "—")</div>
                            }
                        </td>
                        <td class="small text-muted py-2">
                            @foreach (var res in group.Results)
                            {
                                <div><strong class="text-dark">@res.Result</strong> @(string.IsNullOrEmpty(res.Remark) ? "" : $"({res.Remark})")</div>
                            }
                        </td>
                        <td class="py-2"><span class="badge rounded-pill bg-success text-white px-2 py-1 shadow-sm">Prescribed</span></td>
                        <td class="text-end py-2">
                            <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@group.MedicalRecordID" class="btn btn-light btn-sm text-primary border shadow-sm" title="View Record">
                                <i class="fa-regular fa-file-lines"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.PrescribedPatients.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="fa-solid fa-file-circle-xmark d-block fa-2x text-light mb-2"></i> No patients prescribed yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>