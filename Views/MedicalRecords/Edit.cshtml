@model HUIOTClinicMS.ViewModels.MedicalRecordEditViewModel
@{
    ViewData["Title"] = "Edit Medical Record";
}

<h2 class="mb-4">Edit Medical Record</h2>

<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ID" />

    <div class="clinic-card mb-3">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Patient</label>
                <input class="form-control" value="@Model.PatientDisplayName" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Created By</label>
                <input class="form-control" value="@Model.CreatedByDisplayName" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Date</label>
                <input class="form-control" value="@Model.DateTime.ToString("yyyy-MM-dd HH:mm")" disabled />
            </div>
        </div>
    </div>

    <div class="clinic-card mb-3">
        <strong class="d-block mb-3">Visit Details</strong>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="ChiefComplaint" class="form-label"></label>
                <input asp-for="ChiefComplaint" class="form-control" />
                <span asp-validation-for="ChiefComplaint" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="GeneralAppearance" class="form-label"></label>
                <input asp-for="GeneralAppearance" class="form-control" />
                <span asp-validation-for="GeneralAppearance" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Diagnosis" class="form-label"></label>
                <input asp-for="Diagnosis" class="form-control" />
                <span asp-validation-for="Diagnosis" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Treatment" class="form-label"></label>
                <textarea asp-for="Treatment" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Treatment" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Details" asp-route-id="@Model.ID" class="btn btn-outline-primary">Cancel</a>
    </div>
</form>