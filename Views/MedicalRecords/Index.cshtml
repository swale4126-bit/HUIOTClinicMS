@model IEnumerable<HUIOTClinicMS.Models.MedicalRecord>
@{
    ViewData["Title"] = "Medical Records";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="clinic-card border-0 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <strong class="d-flex align-items-center text-dark fs-5">
            <i class="fa-solid fa-file-medical text-primary me-2"></i> Medical Records 
            <span class="badge bg-secondary bg-opacity-10 text-secondary ms-2 rounded-pill fs-6 fw-normal">@Model.Count()</span>
        </strong>
        <div class="d-flex gap-2 flex-wrap">
            <form method="get" class="d-flex">
                <div class="input-group input-group-sm shadow-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Search by diagnosis..." style="min-width:200px;" />
                    <button type="submit" class="btn btn-primary px-3">Search</button>
                </div>
            </form>
            <a asp-action="Create" class="btn btn-primary btn-sm d-flex align-items-center shadow-sm">
                <i class="fa-solid fa-plus me-2"></i> New Record
            </a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th class="fw-semibold py-2">Patient</th>
                    <th class="fw-semibold py-2">Date</th>
                    <th class="fw-semibold py-2">Chief Complaint</th>
                    <th class="fw-semibold py-2">Diagnosis</th>
                    <th class="fw-semibold py-2">Clinician</th>
                    <th class="fw-semibold py-2 text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0 text-nowrap">
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-medium">@(item.Patient != null ? $"{item.Patient.FirstName} {item.Patient.LastName}" : "—")</td>
                        <td class="small text-muted">@item.DateTime.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="text-truncate text-muted small" style="max-width: 250px;" title="@item.ChiefComplaint">
                                @(item.ChiefComplaint ?? "—")
                            </div>
                        </td>
                        <td>
                            <div class="text-truncate text-dark fw-medium" style="max-width: 200px;" title="@item.Diagnosis">
                                @(item.Diagnosis ?? "—")
                            </div>
                        </td>
                        <td class="small text-muted">@(item.CreatedBy != null ? $"{item.CreatedBy.FirstName} {item.CreatedBy.LastName}" : "—")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-light btn-sm text-info border shadow-sm" title="View Record">
                                <i class="fa-regular fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="fa-regular fa-folder-open d-block fa-3x text-light mb-3"></i>
                            @(string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string) ? "No medical records yet." : $"No records match \"{ViewBag.SearchTerm}\".")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
