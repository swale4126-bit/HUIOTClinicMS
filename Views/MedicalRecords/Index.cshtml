@model IEnumerable<HUIOTClinicMS.Models.MedicalRecord>
@{
    ViewData["Title"] = "Medical Records";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="clinic-card">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <strong>Medical Records (@Model.Count())</strong>
        <div class="d-flex gap-2 flex-wrap">
            <form method="get" class="d-flex">
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Search by diagnosis..." style="min-width:200px;" />
                <button type="submit" class="btn btn-outline-primary btn-sm ms-2"><i class="fa-solid fa-magnifying-glass"></i></button>
            </form>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-file-medical me-1"></i> New Record
            </a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Chief Complaint</th>
                    <th>Diagnosis</th>
                    <th>Created By</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.Patient != null ? $"{item.Patient.FirstName} {item.Patient.LastName}" : "—")</td>
                        <td class="small text-muted">@item.DateTime.ToString("yyyy-MM-dd")</td>
                        <td>@(item.ChiefComplaint ?? "—")</td>
                        <td>@(item.Diagnosis ?? "—")</td>
                        <td class="small">@(item.CreatedBy != null ? $"{item.CreatedBy.FirstName} {item.CreatedBy.LastName}" : "—")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-outline-primary btn-sm">View</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted small py-3">
                            @(string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string) ? "No medical records yet." : $"No records match \"{ViewBag.SearchTerm}\".")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
