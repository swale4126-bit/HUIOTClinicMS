@model HUIOTClinicMS.Models.MedicalRecord
@{
    ViewData["Title"] = "Medical Record Details";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="clinic-card mb-3">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <strong class="d-block">@(Model.Patient != null ? $"{Model.Patient.FirstName} {Model.Patient.LastName}" : "—")</strong>
            <span class="small text-muted">@Model.DateTime.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-outline-primary btn-sm">Edit</a>
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-3">Chief Complaint</dt>
        <dd class="col-sm-9">@(Model.ChiefComplaint ?? "—")</dd>

        <dt class="col-sm-3">General Appearance</dt>
        <dd class="col-sm-9">@(Model.GeneralAppearance ?? "—")</dd>

        <dt class="col-sm-3">Diagnosis</dt>
        <dd class="col-sm-9">@(Model.Diagnosis ?? "—")</dd>

        <dt class="col-sm-3">Treatment</dt>
        <dd class="col-sm-9">@(Model.Treatment ?? "—")</dd>

        <dt class="col-sm-3">Notes</dt>
        <dd class="col-sm-9">@(Model.Notes ?? "—")</dd>

        <dt class="col-sm-3">Created By</dt>
        <dd class="col-sm-9">@(Model.CreatedBy != null ? $"{Model.CreatedBy.FirstName} {Model.CreatedBy.LastName}" : "—")</dd>
    </dl>
</div>

<div class="clinic-card mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <strong>Lab Requests</strong>
        <a asp-controller="LabRequests" asp-action="Create" asp-route-medicalRecordId="@Model.ID" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-flask me-1"></i> Request Lab Test
        </a>
    </div>
    @if (Model.LabRequests != null && Model.LabRequests.Any())
    {
        <ul class="mb-0">
            @foreach (var lr in Model.LabRequests)
            {
                <li>@lr.RequestDate.ToString("yyyy-MM-dd") — <span class="badge badge-status-pending">@lr.Status</span></li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted small mb-0">No lab requests for this record yet.</p>
    }
</div>

<div class="clinic-card">
    <strong class="d-block mb-3">Lab Results</strong>
    @if (Model.LabResults != null && Model.LabResults.Any())
    {
        <ul class="mb-0">
            @foreach (var res in Model.LabResults)
            {
                <li>@(res.Result ?? "Pending") — <span class="badge badge-status-completed">@res.Status</span></li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted small mb-0">No lab results for this record yet.</p>
    }
</div>

<div class="mt-3">
    <a asp-action="Index" class="text-decoration-none">&lsaquo; Back to Medical Records</a>
</div>