@model HUIOTClinicMS.ViewModels.MedicalRecordCreateViewModel
@{
    ViewData["Title"] = "New Medical Record";
}

<h2 class="mb-4">New Medical Record</h2>

<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="EncounterID" />

    <div class="clinic-card mb-3">
        <strong class="d-block mb-3">Patient</strong>

        @if (!string.IsNullOrEmpty(Model.PatientDisplayName))
        {
            <input type="hidden" asp-for="PatientID" />
            <input class="form-control mb-2" value="@Model.PatientDisplayName" disabled />
        }
        else
        {
            <label asp-for="PatientID" class="form-label">Select Patient</label>
            <select asp-for="PatientID" class="form-select mb-2" asp-items="ViewBag.Patients">
                <option value="">Select patient</option>
            </select>
            <span asp-validation-for="PatientID" class="text-danger small"></span>
        }

        @if (!string.IsNullOrEmpty(Model.VitalsSummary))
        {
            <div class="alert alert-info py-2 mb-0">
                <i class="fa-solid fa-heart-pulse me-1"></i> <strong>Triage Vitals:</strong> @Model.VitalsSummary
            </div>
        }
    </div>

    <div class="clinic-card mb-3">
        <strong class="d-block mb-3">Visit Details</strong>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="ChiefComplaint" class="form-label"></label>
                <input asp-for="ChiefComplaint" class="form-control" placeholder="e.g. Cough and fever for 3 days" />
                <span asp-validation-for="ChiefComplaint" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="GeneralAppearance" class="form-label"></label>
                <input asp-for="GeneralAppearance" class="form-control" placeholder="e.g. Alert, mild distress" />
                <span asp-validation-for="GeneralAppearance" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Diagnosis" class="form-label"></label>
                <input asp-for="Diagnosis" class="form-control" placeholder="e.g. Upper Respiratory Infection" />
                <span asp-validation-for="Diagnosis" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Treatment" class="form-label"></label>
                <textarea asp-for="Treatment" class="form-control" rows="2" placeholder="e.g. Amoxicillin 500mg TID x 5 days"></textarea>
                <span asp-validation-for="Treatment" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Additional notes"></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-file-medical me-1"></i> Save Medical Record
        </button>
        @if (Model.EncounterID.HasValue)
        {
            <a asp-controller="ClinicalEncounters" asp-action="Details" asp-route-id="@Model.EncounterID.Value" class="btn btn-outline-secondary">Cancel</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
        }
    </div>
</form>