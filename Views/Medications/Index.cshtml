@model IEnumerable<HUIOTClinicMS.Models.Medication>
@{
    ViewData["Title"] = "Medication Registry";
}

<div class="clinic-card border-0 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <strong class="d-flex align-items-center text-dark fs-5">
            <i class="fa-solid fa-pills text-info me-2"></i> Dispensed Medications 
            <span class="badge bg-secondary bg-opacity-10 text-secondary ms-2 rounded-pill fs-6 fw-normal">@Model.Count()</span>
        </strong>
        <form method="get" class="d-flex">
            <div class="input-group input-group-sm shadow-sm">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Search by medication..." style="min-width:220px;" />
                <button type="submit" class="btn btn-primary px-3">Search</button>
            </div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th class="fw-semibold py-2">Patient</th>
                    <th class="fw-semibold py-2">Medication</th>
                    <th class="fw-semibold py-2">Dose</th>
                    <th class="fw-semibold py-2">Qty Dispensed</th>
                    <th class="fw-semibold py-2">Pharmacist</th>
                    <th class="fw-semibold py-2">Date</th>
                    <th class="fw-semibold py-2 text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0 text-nowrap">
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-medium">@(item.Prescription?.Patient != null ? $"{item.Prescription.Patient.FirstName} {item.Prescription.Patient.LastName}" : "—")</td>
                        <td>
                            <span class="text-dark fw-medium">@item.MedicationName</span> 
                            <span class="badge bg-light text-muted ms-1 border">@(item.MedicationType ?? "—")</span>
                        </td>
                        <td class="small text-secondary">@(item.PrescribedDose ?? "—")</td>
                        <td class="fw-semibold text-success">@(item.DispensedQuantity?.ToString() ?? "—")</td>
                        <td class="small text-muted">@(item.Pharmacist != null ? $"{item.Pharmacist.FirstName} {item.Pharmacist.LastName}" : "—")</td>
                        <td class="small text-muted">@item.DispensedDate.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.MedicationID" class="btn btn-light btn-sm text-info border shadow-sm" title="View Details">
                                <i class="fa-regular fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="fa-solid fa-capsules d-block fa-3x text-light mb-3"></i>
                            @(string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string) ? "No medications dispensed yet." : $"No medications match \"{ViewBag.SearchTerm}\".")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
