@model HUIOTClinicMS.ViewModels.LabResultCreateViewModel

@{
    ViewData["Title"] = "Enter Lab Result";
}

<h2 class="mb-4">Enter Lab Result</h2>

<div class="clinic-card max-w-600">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="LabRequestID" class="form-label fw-bold"></label>
            <select asp-for="LabRequestID" class="form-select" asp-items="ViewBag.LabRequests">
                <option value="">-- Select Patient's Lab Request --</option>
            </select>
            <span asp-validation-for="LabRequestID" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <h5 class="form-label fw-bold border-bottom pb-2 mb-3">Test Results Entry</h5>
            @if(Model.AvailableTestTypes != null && Model.AvailableTestTypes.Any())
            {
                foreach (var test in Model.AvailableTestTypes)
                {
                    <div class="card mb-3 border border-secondary shadow-sm">
                        <div class="card-header bg-light py-2">
                            <h6 class="mb-0 fw-bold text-primary">
                                <input type="hidden" name="SelectedTestTypeIds" value="@test.ID" />
                                <i class="fa-solid fa-flask me-2"></i>@test.TestName
                            </h6>
                        </div>
                        <div class="card-body py-3">
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Result <span class="text-danger">*</span></label>
                                <textarea name="Results[@test.ID]" class="form-control form-control-sm" rows="2" placeholder="Enter the detailed result here..." required></textarea>
                            </div>
                            <div>
                                <label class="form-label fw-semibold small">Remarks (Optional)</label>
                                <input name="Remarks[@test.ID]" class="form-control form-control-sm" placeholder="Any additional clinical remarks" />
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning small">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> Please select a Lab Request to view and enter results for the required test types.
                </div>
            }
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">Submit Result</button>
            <a asp-controller="LabTechnician" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
