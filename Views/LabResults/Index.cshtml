@model IEnumerable<HUIOTClinicMS.Models.LabResult>
@{
    ViewData["Title"] = "Lab Results";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="clinic-card">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <strong>Lab Results (@Model.Count())</strong>
        <div class="d-flex gap-2 flex-wrap">
            <form method="get" class="d-flex">
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Search by patient name..." style="min-width:200px;" />
                <button type="submit" class="btn btn-outline-primary btn-sm ms-2"><i class="fa-solid fa-magnifying-glass"></i></button>
            </form>
            <a asp-controller="MedicalRecords" asp-action="Index" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-file-medical me-1"></i> Go to Medical Records
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted small py-4">
            @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string))
            {
                <p class="mb-0">No lab results match "@ViewBag.SearchTerm".</p>
            }
            else
            {
                <p class="mb-2">No lab results yet.</p>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr class="text-muted small">
                        <th>Patient</th>
                        <th>Test Type</th>
                        <th>Result</th>
                        <th>Performed By</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var badgeClass = item.Status switch
                        {
                            "Completed" => "badge-status-completed",
                            "In Progress" => "badge-status-inprogress",
                            _ => "badge-status-pending"
                        };
                        <tr>
                            <td>@(item.MedicalRecord?.Patient != null ? $"{item.MedicalRecord.Patient.FirstName} {item.MedicalRecord.Patient.LastName}" : "—")</td>
                            <td class="small">@(item.TestType?.TestName ?? "—")</td>
                            <td class="small">@item.Result</td>
                            <td class="small">@(item.ResultPerformedBy != null ? $"{item.ResultPerformedBy.FirstName} {item.ResultPerformedBy.LastName}" : "—")</td>
                            <td><span class="badge @badgeClass">@item.Status</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-outline-primary btn-sm">View</a>
                                @if (User.IsInRole("HealthOfficer"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-outline-primary btn-sm text-danger">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
