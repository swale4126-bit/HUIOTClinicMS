@model HUIOTClinicMS.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Your Profile";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="d-flex align-items-center mb-4">
    <a href="/" class="btn btn-outline-secondary me-3 shadow-sm rounded-circle d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;" title="Back to Dashboard"><i class="fa-solid fa-arrow-left"></i></a>
    <h3 class="mb-0 fw-bold text-dark">Your Profile</h3>
</div>

<div class="clinic-card border-0 shadow-sm" style="max-width: 560px;">
    <div class="d-flex align-items-center gap-4 mb-4 border-bottom pb-4">
        @if (!string.IsNullOrEmpty(Model.ProfilePhotoUrl))
        {
            <img src="@Model.ProfilePhotoUrl" class="clinic-profile-photo-lg shadow-sm border" alt="Profile photo" style="width: 90px; height: 90px;" />
        }
        else
        {
            <div class="clinic-avatar-initials clinic-avatar-initials-lg shadow-sm border bg-primary bg-opacity-10 text-primary" style="width: 90px; height: 90px; font-size: 2rem;">
                @string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => char.ToUpper(n[0])))
            </div>
        }
        <div>
            <strong class="d-block fs-4 text-dark mb-1">@Model.FullName</strong>
            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 rounded-pill fw-medium"><i class="fa-solid fa-id-badge me-2"></i> @Model.RoleLabel</span>
        </div>
    </div>

    <dl class="row mb-0 mt-3 align-items-center bg-light p-3 rounded shadow-sm border border-secondary border-opacity-10">
        <dt class="col-sm-4 text-muted fw-semibold small text-uppercase mb-2 mb-sm-0"><i class="fa-solid fa-envelope me-2 text-primary opacity-75"></i> Email</dt>
        <dd class="col-sm-8 fw-medium text-dark mb-3 mb-sm-0">@Model.Email</dd>
        
        <div class="w-100 d-none d-sm-block my-2 border-bottom border-secondary border-opacity-10"></div>
        
        <dt class="col-sm-4 text-muted fw-semibold small text-uppercase mb-2 mb-sm-0 mt-2 mt-sm-0"><i class="fa-solid fa-phone me-2 text-primary opacity-75"></i> Phone Number</dt>
        <dd class="col-sm-8 fw-medium text-dark mb-0 mt-2 mt-sm-0">@(Model.PhoneNumber ?? "—")</dd>
    </dl>

    <div class="d-flex gap-2 pt-4 mt-2">
        <a asp-action="Edit" class="btn btn-primary shadow-sm flex-grow-1">
            <i class="fa-solid fa-pen-to-square me-2"></i> Edit Profile
        </a>
        <a asp-action="UploadPhoto" class="btn btn-outline-primary shadow-sm flex-grow-1">
            <i class="fa-solid fa-camera-retro me-2"></i> Update Photo
        </a>
    </div>
</div>