@model HUIOTClinicMS.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Your Profile";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="d-flex align-items-center mb-4">
    <a href="/" class="btn btn-outline-secondary me-3"><i class="fa-solid fa-arrow-left me-2"></i>Back to Dashboard</a>
    <h3 class="mb-0">Your Profile</h3>
</div>

<div class="clinic-card" style="max-width: 560px;">
    <div class="d-flex align-items-center gap-3 mb-4">
        @if (!string.IsNullOrEmpty(Model.ProfilePhotoUrl))
        {
            <img src="@Model.ProfilePhotoUrl" class="clinic-profile-photo-lg" alt="Profile photo" />
        }
        else
        {
            <div class="clinic-avatar-initials clinic-avatar-initials-lg">
                @string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => char.ToUpper(n[0])))
            </div>
        }
        <div>
            <strong class="d-block fs-5">@Model.FullName</strong>
            <span class="text-muted small">@Model.RoleLabel</span>
        </div>
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4">Phone Number</dt>
        <dd class="col-sm-8">@(Model.PhoneNumber ?? "—")</dd>
    </dl>

    <div class="d-flex gap-2 mt-3">
        <a asp-action="Edit" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-pen me-1"></i> Edit Profile
        </a>
        <a asp-action="UploadPhoto" class="btn btn-outline-primary btn-sm">
            <i class="fa-solid fa-camera me-1"></i> Upload Photo
        </a>
    </div>
</div>