@model HUIOTClinicMS.ViewModels.ProfileEditViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="clinic-card border-0 shadow-sm" style="max-width: 500px;">
    <div class="d-flex align-items-center mb-4 border-bottom pb-3">
        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
            <i class="fa-solid fa-user-pen"></i>
        </div>
        <h4 class="mb-0 fw-bold text-dark">Edit Profile</h4>
    </div>

    <form asp-action="Edit" method="post">
        <div class="mb-4">
            <label asp-for="FullName" class="form-label fw-semibold text-secondary small text-uppercase">Full Name</label>
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-user"></i></span>
                <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="Enter full name" />
            </div>
            <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
        </div>
        
        <div class="mb-4">
            <label asp-for="Email" class="form-label fw-semibold text-secondary small text-uppercase">Email</label>
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-envelope"></i></span>
                <input type="email" asp-for="Email" class="form-control border-start-0 ps-0" placeholder="Enter email address" />
            </div>
            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            <small class="text-muted d-block mt-2"><i class="fa-solid fa-triangle-exclamation text-warning me-1"></i> Changing this will also change your login username.</small>
        </div>
        
        <div class="mb-4">
            <label asp-for="PhoneNumber" class="form-label fw-semibold text-secondary small text-uppercase">Phone Number</label>
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-phone"></i></span>
                <input asp-for="PhoneNumber" class="form-control border-start-0 ps-0" placeholder="Enter phone number" />
            </div>
        </div>
        
        <div class="d-flex gap-2 pt-3 border-top mt-4">
            <button type="submit" class="btn btn-primary shadow-sm px-4">
                <i class="fa-solid fa-floppy-disk me-2"></i> Save Changes
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}