@model HUIOTClinicMS.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
}

@if (Model.Patient == null)
{
    <div class="clinic-card">
        <p class="text-muted mb-0">
            Your account isn't linked to a patient record yet. Please visit the clinic
            to complete registration with a Nurse.
        </p>
    </div>
}
else
{
    <div class="clinic-card mb-4" style="background-color: var(--clinic-primary); color: #fff;">
        <div class="small" style="opacity: 0.8;">Welcome back</div>
        <h4 class="fw-bold mb-1">Hello, @Model.Patient.FirstName! 👋</h4>
        <div class="small" style="opacity: 0.8;">
            @(Model.Patient.Department?.DepartmentName ?? "—") &bull; @Model.Patient.CardNumber
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="clinic-card">
                <div class="clinic-metric-value">@Model.MyVisits</div>
                <div class="clinic-metric-label">My Visits</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="clinic-card">
                <div class="clinic-metric-value">@Model.PendingLabResults</div>
                <div class="clinic-metric-label">Pending Lab Results</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="clinic-card">
                <div class="clinic-metric-value">@Model.ActivePrescriptions</div>
                <div class="clinic-metric-label">Active Prescriptions</div>
            </div>
        </div>
    </div>

    <div class="clinic-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <strong>Recent Visits</strong>
            <a asp-controller="Student" asp-action="MedicalRecords" class="small text-decoration-none">View All &rsaquo;</a>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr class="text-muted small">
                        <th>Date</th>
                        <th>Chief Complaint</th>
                        <th>Diagnosis</th>
                        <th>Treated By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var visit in Model.RecentVisits)
                    {
                        <tr>
                            <td class="small text-muted">@visit.DateTime.ToString("yyyy-MM-dd")</td>
                            <td>@(visit.ChiefComplaint ?? "—")</td>
                            <td>@(visit.Diagnosis ?? "—")</td>
                            <td class="small">@(visit.CreatedBy != null ? $"{visit.CreatedBy.FirstName} {visit.CreatedBy.LastName}" : "—")</td>
                        </tr>
                    }
                    @if (!Model.RecentVisits.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted small py-3">No visits recorded yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}