@model HUIOTClinicMS.ViewModels.QueueDashboardViewModel
@{
    ViewData["Title"] = "Queue Dashboard";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-start">
            <i class="fa-solid fa-triangle-exclamation me-3 fs-4 text-danger mt-1"></i>
            <div class="flex-grow-1">
                <div class="fw-bold mb-1">Service Incomplete &mdash; Action Required</div>
                <div class="small">@TempData["ErrorMessage"]</div>
                @if (Model.CurrentServingEncounterID.HasValue)
                {
                    <div class="mt-2">
                        <a asp-controller="ClinicalEncounters" asp-action="Details" asp-route-id="@Model.CurrentServingEncounterID.Value" class="btn btn-sm btn-danger px-3 shadow-sm">
                            <i class="fa-solid fa-file-medical me-1"></i> Open Encounter Chart to Record Service
                        </a>
                    </div>
                }
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2 fs-5 align-middle"></i>
        <span>@TempData["SuccessMessage"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
    <div>
        <h5 class="d-flex align-items-center text-dark fw-bold mb-1">
            <i class="fa-solid fa-users-line text-primary me-2"></i> Active Patient Queues
        </h5>
        <div class="text-muted small">Monitor, call, and manage real-time patient queue flow by department</div>
    </div>
    
    <form method="get" class="d-flex align-items-center gap-2">
        <div class="input-group input-group-sm shadow-sm">
            <span class="input-group-text bg-white border-end-0 text-muted fw-medium">Service Point:</span>
            <select name="spId" id="spId" class="form-select border-start-0 ps-0 fw-bold text-dark" onchange="this.form.submit()" style="min-width: 200px;">
                @if (User.IsInRole("HealthOfficer"))
                {
                    if (Model.SelectedServicePointID == 0)
                    {
                        <option value="0" selected>All Departments</option>
                    }
                    else
                    {
                        <option value="0">All Departments</option>
                    }
                }
                @foreach (var sp in Model.ServicePoints)
                {
                    if (sp.ID == Model.SelectedServicePointID)
                    {
                        <option value="@sp.ID" selected>@sp.Name</option>
                    }
                    else
                    {
                        <option value="@sp.ID">@sp.Name</option>
                    }
                }
            </select>
        </div>
    </form>
</div>

<div class="row mb-4 g-3">
    <div class="col-md-4">
        <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-users fs-4"></i>
            </div>
            <h2 class="text-primary fw-bold mb-1">@Model.WaitingCount</h2>
            <small class="text-muted fw-semibold text-uppercase" style="letter-spacing: 1px;">WAITING</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
            <div class="bg-info bg-opacity-10 text-info rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-user-doctor fs-4"></i>
            </div>
            <h2 class="text-info fw-bold mb-1">@Model.InServiceCount</h2>
            <small class="text-muted fw-semibold text-uppercase" style="letter-spacing: 1px;">IN SERVICE</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
            <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                <i class="fa-solid fa-check-double fs-4"></i>
            </div>
            <h2 class="text-success fw-bold mb-1">@Model.CompletedCount</h2>
            <small class="text-muted fw-semibold text-uppercase" style="letter-spacing: 1px;">COMPLETED</small>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="clinic-card border-0 shadow-sm h-100">
            <h5 class="mb-4 text-dark fw-bold"><i class="fa-solid fa-street-view text-primary me-2"></i> Currently Serving</h5>
            
            @if (Model.SelectedServicePointID == 0)
            {
                <div class="text-center py-5 rounded bg-light border-0">
                    <i class="fa-solid fa-layer-group fa-4x text-muted mb-3 opacity-25"></i>
                    <h4 class="text-muted mb-4 fw-bold">All Departments View</h4>
                    <p class="text-muted small">Select a specific service point to manage its queue.</p>
                </div>
            }
            else if (Model.CurrentServingQueue != null)
            {
                <div class="text-center py-5 rounded bg-primary bg-opacity-10 border-0 mb-4 shadow-sm position-relative overflow-hidden">
                    <div class="position-absolute top-0 end-0 p-3 opacity-25">
                        <i class="fa-solid fa-hashtag fa-4x text-primary"></i>
                    </div>
                    <h1 class="display-2 fw-bold text-primary mb-2 position-relative z-index-1">@Model.CurrentServingQueue.TokenNumber</h1>
                    <h5 class="text-dark fw-bold mb-1 position-relative z-index-1">@Model.CurrentServingQueue.Patient?.FirstName @Model.CurrentServingQueue.Patient?.LastName</h5>
                    <div class="mt-3 position-relative z-index-1">
                        <span class="badge rounded-pill bg-info text-white border border-info px-3 py-2 shadow-sm me-2">
                            <i class="fa-solid fa-user-doctor me-1"></i> @Model.CurrentServingQueue.QueueStatus
                        </span>
                        <span class="badge rounded-pill bg-white text-info border border-info px-3 py-2 shadow-sm">@Model.CurrentServingQueue.QueueType</span>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    @if (User.IsInRole("LabTechnician"))
                    {
                        if (Model.CurrentServingLabRequestID.HasValue)
                        {
                            <a asp-controller="LabResults" asp-action="Create" asp-route-labRequestId="@Model.CurrentServingLabRequestID.Value" class="btn btn-primary shadow-sm px-4">
                                <i class="fa-solid fa-flask-vial me-2"></i>Enter Lab Results & Handover to Nurse
                            </a>
                        }
                        else
                        {
                            <a asp-controller="LabResults" asp-action="Create" class="btn btn-primary shadow-sm px-4">
                                <i class="fa-solid fa-flask-vial me-2"></i>Enter Lab Results & Handover to Nurse
                            </a>
                        }
                    }
                    else if (User.IsInRole("Pharmacist"))
                    {
                        <a asp-controller="Pharmacy" asp-action="Index" class="btn btn-primary shadow-sm px-4">
                            <i class="fa-solid fa-prescription-bottle-medical me-2"></i>Pharmacy Dispensing
                        </a>
                    }
                    else if (Model.CurrentServingEncounterID.HasValue)
                    {
                        <a asp-controller="ClinicalEncounters" asp-action="Details" asp-route-id="@Model.CurrentServingEncounterID.Value" class="btn btn-primary shadow-sm px-4">
                            <i class="fa-solid fa-file-medical me-2"></i>Open Encounter Chart
                        </a>
                    }
                    
                    <form asp-action="CompleteService" method="post">
                        <input type="hidden" name="queueId" value="@Model.CurrentServingQueue.ID" />
                        <input type="hidden" name="servicePointId" value="@Model.SelectedServicePointID" />
                        <button type="submit" class="btn btn-success shadow-sm px-4"><i class="fa-solid fa-check me-2"></i>Complete</button>
                    </form>
                    
                    <form asp-action="CancelService" method="post" onsubmit="return confirm('Are you sure you want to cancel this token?');">
                        <input type="hidden" name="queueId" value="@Model.CurrentServingQueue.ID" />
                        <input type="hidden" name="servicePointId" value="@Model.SelectedServicePointID" />
                        <button type="submit" class="btn btn-outline-danger shadow-sm px-4"><i class="fa-solid fa-xmark me-2"></i>Cancel</button>
                    </form>
                </div>
            }
            else
            {
                <div class="text-center py-5 rounded bg-light border-0">
                    <i class="fa-regular fa-id-badge fa-4x text-muted mb-3 opacity-25"></i>
                    <h4 class="text-muted mb-4 fw-bold">No Active Patient</h4>
                    
                    <form asp-action="CallNext" method="post">
                        <input type="hidden" name="servicePointId" value="@Model.SelectedServicePointID" />
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm px-5 rounded-pill" @(Model.WaitingCount == 0 ? "disabled" : "")>
                            <i class="fa-solid fa-bullhorn me-2"></i> Call Next Patient
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="clinic-card border-0 shadow-sm h-100">
            <h5 class="mb-4 text-dark fw-bold"><i class="fa-solid fa-list-ol text-primary me-2"></i> Waiting List</h5>
            
            @if (Model.WaitingQueues.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="fw-semibold py-2">Token</th>
                                <th class="fw-semibold py-2">Patient Name</th>
                                <th class="fw-semibold py-2">Time</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var q in Model.WaitingQueues)
                            {
                                <tr>
                                    <td class="py-3">
                                        <div class="d-flex align-items-center">
                                            <span class="badge bg-primary rounded-pill me-2 fs-6 shadow-sm">@q.TokenNumber</span>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill">@q.QueueType</span>
                                        </div>
                                    </td>
                                    <td class="fw-medium text-dark">@q.Patient?.FirstName @q.Patient?.LastName</td>
                                    <td class="text-muted small">
                                        <i class="fa-regular fa-clock me-1 opacity-50"></i> @q.CreatedAt.ToString("hh:mm tt")
                                        @if (Model.SelectedServicePointID == 0)
                                        {
                                            <div class="mt-1"><span class="badge bg-light text-dark border">@q.QueueStatus</span></div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-mug-hot d-block fa-3x text-light mb-3"></i>
                    <p class="mb-0 fw-medium">Queue is empty.</p>
                </div>
            }
        </div>
    </div>
</div>
