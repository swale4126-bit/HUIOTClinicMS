@model HUIOTClinicMS.Models.Prescription
@{
    ViewData["Title"] = "Delete Prescription";
}

<h2 class="mb-4">Delete Prescription</h2>

<div class="clinic-card mb-3">
    <p class="text-danger fw-semibold">Are you sure you want to delete this prescription? This cannot be undone.</p>
    <dl class="row mb-0">
        <dt class="col-sm-3">Patient</dt>
        <dd class="col-sm-9">@(Model.Patient != null ? $"{Model.Patient.FirstName} {Model.Patient.LastName}" : "—")</dd>
        <dt class="col-sm-3">Rx</dt>
        <dd class="col-sm-9">@Model.RX</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="PrescriptionID" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
</form>