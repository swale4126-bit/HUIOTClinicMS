@model HUIOTClinicMS.Models.Prescription
@{
    ViewData["Title"] = "Prescription Details";
    var badgeClass = Model.Status == "Dispensed" ? "badge-status-completed" : "badge-status-pending";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="clinic-card mb-3">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <strong class="d-block">@(Model.Patient != null ? $"{Model.Patient.FirstName} {Model.Patient.LastName}" : "—")</strong>
            <span class="small text-muted">@Model.TimeDate.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        <div class="d-flex gap-2">
            <span class="badge @badgeClass align-self-center">@Model.Status</span>
            @if (Model.Status != "Dispensed" && (User.IsInRole("Nurse") || User.IsInRole("HealthOfficer")))
            {
                <a asp-action="Edit" asp-route-id="@Model.PrescriptionID" class="btn btn-outline-primary btn-sm">Edit</a>
            }
            @if (Model.Status != "Dispensed" && User.IsInRole("Pharmacist"))
            {
                <a asp-action="Dispense" asp-route-id="@Model.PrescriptionID" class="btn btn-primary btn-sm">Dispense</a>
            }
        </div>
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-3">Prescription (Rx)</dt>
        <dd class="col-sm-9">@Model.RX</dd>

        <dt class="col-sm-3">Prescribed By</dt>
        <dd class="col-sm-9">@(Model.PrescribedBy != null ? $"{Model.PrescribedBy.FirstName} {Model.PrescribedBy.LastName}" : "—")</dd>

        <dt class="col-sm-3">Assigned Pharmacist</dt>
        <dd class="col-sm-9">
            @(Model.AssignedToStaff != null ? $"{Model.AssignedToStaff.FirstName} {Model.AssignedToStaff.LastName}" : "Unassigned (General Queue)")
            @if (Model.Status != "Dispensed")
            {
                <a asp-controller="TaskAssignment" asp-action="Reassign" asp-route-taskType="Prescription" asp-route-taskId="@Model.PrescriptionID" class="btn btn-outline-secondary btn-sm ms-2 py-0 px-2" style="font-size:0.75rem;">
                    <i class="fa-solid fa-user-pen me-1"></i>Reassign
                </a>
            }
        </dd>

        <dt class="col-sm-3">Based On Lab Result</dt>
        <dd class="col-sm-9">@(Model.LabResult?.TestType?.TestName ?? "—") — @(Model.LabResult?.Result ?? "—")</dd>
    </dl>
</div>

@if (Model.Medication != null)
{
    <div class="clinic-card">
        <strong class="d-block mb-3">Dispensed Medication</strong>
        <dl class="row mb-0">
            <dt class="col-sm-3">Medication</dt>
            <dd class="col-sm-9">@Model.Medication.MedicationName (@(Model.Medication.MedicationType ?? "—"))</dd>
            <dt class="col-sm-3">Dose</dt>
            <dd class="col-sm-9">@(Model.Medication.PrescribedDose ?? "—")</dd>
            <dt class="col-sm-3">Quantity</dt>
            <dd class="col-sm-9">@(Model.Medication.DispensedQuantity?.ToString() ?? "—")</dd>
            <dt class="col-sm-3">Dispensed By</dt>
            <dd class="col-sm-9">@(Model.Medication.Pharmacist != null ? $"{Model.Medication.Pharmacist.FirstName} {Model.Medication.Pharmacist.LastName}" : "—")</dd>
        </dl>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="text-decoration-none">&lsaquo; Back to Prescriptions</a>
</div>