@model IEnumerable<HUIOTClinicMS.Models.Prescription>
@{
    ViewData["Title"] = "Prescriptions";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="clinic-card border-0 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <strong class="d-flex align-items-center text-dark fs-5">
            <i class="fa-solid fa-prescription-bottle text-success me-2"></i> Prescriptions 
            <span class="badge bg-secondary bg-opacity-10 text-secondary ms-2 rounded-pill fs-6 fw-normal">@Model.Count()</span>
        </strong>
        <form method="get" class="d-flex">
            <div class="input-group input-group-sm shadow-sm">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Search by Rx..." style="min-width:220px;" />
                <button type="submit" class="btn btn-primary px-3">Search</button>
            </div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th class="fw-semibold py-2">Patient</th>
                    <th class="fw-semibold py-2">Rx Details</th>
                    <th class="fw-semibold py-2">Assigned To</th>
                    <th class="fw-semibold py-2">Prescriber</th>
                    <th class="fw-semibold py-2">Date</th>
                    <th class="fw-semibold py-2">Status</th>
                    <th class="fw-semibold py-2 text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0 text-nowrap">
                @foreach (var item in Model)
                {
                    var badgeClass = item.Status == "Dispensed" 
                        ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" 
                        : item.Status == "PartiallyDispensed" 
                            ? "bg-info bg-opacity-10 text-info border border-info border-opacity-25" 
                            : "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25";
                    <tr>
                        <td class="fw-medium">@(item.Patient != null ? $"{item.Patient.FirstName} {item.Patient.LastName}" : "—")</td>
                        <td>
                            <div class="text-truncate text-secondary small" style="max-width: 300px;" title="@item.RX">
                                @item.RX
                            </div>
                        </td>
                        <td class="small">
                            @if (item.AssignedToStaff != null)
                            {
                                <span class="badge bg-light text-dark border">
                                    @item.AssignedToStaff.FirstName @item.AssignedToStaff.LastName
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25">
                                    Unassigned
                                </span>
                            }
                            @if (item.Status != "Dispensed")
                            {
                                <a asp-controller="TaskAssignment" asp-action="Reassign" asp-route-taskType="Prescription" asp-route-taskId="@item.PrescriptionID" class="text-secondary ms-1" title="Reassign">
                                    <i class="fa-solid fa-user-pen" style="font-size: 0.75rem;"></i>
                                </a>
                            }
                        </td>
                        <td class="small text-muted">@(item.PrescribedBy != null ? $"{item.PrescribedBy.FirstName} {item.PrescribedBy.LastName}" : "—")</td>
                        <td class="small text-muted">@item.TimeDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="badge rounded-pill fw-normal @badgeClass">@item.Status</span></td>
                        <td class="text-end">
                            <div class="btn-group shadow-sm">
                                <a asp-action="Details" asp-route-id="@item.PrescriptionID" class="btn btn-light btn-sm text-info border" title="View Prescription">
                                    <i class="fa-regular fa-eye"></i>
                                </a>
                                @if (User.IsInRole("Pharmacist") && (item.Status == "Pending" || item.Status == "PartiallyDispensed"))
                                {
                                    <a asp-action="Dispense" asp-route-id="@item.PrescriptionID" class="btn btn-primary btn-sm border-primary" title="Dispense Medication">
                                        <i class="fa-solid fa-pills"></i> Dispense
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="fa-solid fa-file-prescription d-block fa-3x text-light mb-3"></i>
                            @(string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string) ? "No prescriptions yet." : $"No prescriptions match \"{ViewBag.SearchTerm}\".")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
