@model IEnumerable<HUIOTClinicMS.Models.Prescription>
@{
    ViewData["Title"] = "Prescriptions";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="clinic-card">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <strong>Prescriptions (@Model.Count())</strong>
        <form method="get" class="d-flex">
            <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Search by Rx..." style="min-width:200px;" />
            <button type="submit" class="btn btn-outline-primary btn-sm ms-2"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>Patient</th>
                    <th>Rx</th>
                    <th>Prescribed By</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var badgeClass = item.Status == "Dispensed" ? "badge-status-completed" : "badge-status-pending";
                    <tr>
                        <td>@(item.Patient != null ? $"{item.Patient.FirstName} {item.Patient.LastName}" : "—")</td>
                        <td class="small">@item.RX</td>
                        <td class="small">@(item.PrescribedBy != null ? $"{item.PrescribedBy.FirstName} {item.PrescribedBy.LastName}" : "—")</td>
                        <td class="small text-muted">@item.TimeDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge @badgeClass">@item.Status</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.PrescriptionID" class="btn btn-outline-primary btn-sm">View</a>
                            @if (User.IsInRole("Pharmacist") && item.Status == "Pending")
                            {
                                <a asp-action="Dispense" asp-route-id="@item.PrescriptionID" class="btn btn-primary btn-sm">Dispense</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted small py-3">
                            @(string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string) ? "No prescriptions yet." : $"No prescriptions match \"{ViewBag.SearchTerm}\".")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
