@model IEnumerable<HUIOTClinicMS.Models.LabRequest>
@{
    ViewData["Title"] = "Lab Requests";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="clinic-card border-0 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <strong class="d-flex align-items-center text-dark fs-5">
            <i class="fa-solid fa-flask text-warning me-2"></i> Lab Requests 
            <span class="badge bg-secondary bg-opacity-10 text-secondary ms-2 rounded-pill fs-6 fw-normal">@Model.Count()</span>
        </strong>
        <a asp-controller="MedicalRecords" asp-action="Index" class="btn btn-primary btn-sm d-flex align-items-center shadow-sm">
            <i class="fa-solid fa-file-medical me-2"></i> Go to Medical Records
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="fa-solid fa-vial d-block fa-3x text-light mb-3"></i>
            <p class="mb-2">No lab requests yet.</p>
            <p class="mb-0 small">
                Lab requests are created from a patient's Medical Record.<br/>
                Open a Medical Record and click <strong>"Request Lab Test"</strong> to create one.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="fw-semibold py-2">Patient</th>
                        <th class="fw-semibold py-2">Tests</th>
                        <th class="fw-semibold py-2">Assigned To</th>
                        <th class="fw-semibold py-2">Requested By</th>
                        <th class="fw-semibold py-2">Date</th>
                        <th class="fw-semibold py-2">Status</th>
                        <th class="fw-semibold py-2 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0 text-nowrap">
                    @foreach (var item in Model)
                    {
                        var badgeClass = item.Status switch
                        {
                            "Completed" => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
                            "In Progress" => "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25",
                            _ => "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25"
                        };
                        <tr>
                            <td class="fw-medium">@(item.Patient != null ? $"{item.Patient.FirstName} {item.Patient.LastName}" : "—")</td>
                            <td>
                                <div class="text-truncate text-secondary" style="max-width: 250px;" title="@(item.TestTypes.Any() ? string.Join(", ", item.TestTypes.Select(t => t.TestName)) : "—")">
                                    @(item.TestTypes.Any() ? string.Join(", ", item.TestTypes.Select(t => t.TestName)) : "—")
                                </div>
                            </td>
                            <td class="small">
                                @if (item.AssignedToStaff != null)
                                {
                                    <span class="badge bg-light text-dark border">
                                        @item.AssignedToStaff.FirstName @item.AssignedToStaff.LastName
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25">
                                        Unassigned
                                    </span>
                                }
                                @if (item.Status != "Completed")
                                {
                                    <a asp-controller="TaskAssignment" asp-action="Reassign" asp-route-taskType="LabRequest" asp-route-taskId="@item.LabRequestID" class="text-secondary ms-1" title="Reassign">
                                        <i class="fa-solid fa-user-pen" style="font-size: 0.75rem;"></i>
                                    </a>
                                }
                            </td>
                            <td class="small text-muted">@(item.RequestedBy != null ? $"{item.RequestedBy.FirstName} {item.RequestedBy.LastName}" : "—")</td>
                            <td class="small text-muted">@item.RequestDate.ToString("MMM dd, yyyy")</td>
                            <td><span class="badge rounded-pill fw-normal @badgeClass">@item.Status</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.LabRequestID" class="btn btn-light btn-sm text-info border shadow-sm" title="View Request">
                                    <i class="fa-regular fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>