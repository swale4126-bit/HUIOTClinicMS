@model HUIOTClinicMS.ViewModels.LabRequestCreateViewModel

@{
    ViewData["Title"] = "Create Lab Request";
}

<h2 class="mb-4">Create Lab Request</h2>

<div class="clinic-card max-w-600">
    <div class="mb-4">
        <strong>Patient:</strong> @Model.PatientDisplayName
    </div>
    
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <input type="hidden" asp-for="EncounterID" />
            <input type="hidden" asp-for="MedicalRecordID" />
            <input type="hidden" asp-for="PatientID" />

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="IsStat" id="isStatCheckbox" />
                <label class="form-check-label text-danger fw-bold" for="isStatCheckbox">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> STAT Urgent / Emergency Priority
                </label>
            </div>

            <div class="form-group mb-3">
                <label class="control-label fw-bold">Tests to Request</label>
                <div class="border p-3 rounded bg-light">
                    @foreach (var test in Model.AvailableTestTypes)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedTestTypeIds" value="@test.ID" id="test_@test.ID" />
                            <label class="form-check-label" for="test_@test.ID">
                                @test.TestName
                            </label>
                        </div>
                    }
                </div>
                <span asp-validation-for="SelectedTestTypeIds" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="AssignedToStaffID" class="control-label fw-bold"></label>
                <select asp-for="AssignedToStaffID" class="form-select">
                    <option value="">-- General Lab Queue (Any Available Technician) --</option>
                    @foreach (var tech in Model.AvailableLabTechs)
                    {
                        var displayName = string.IsNullOrWhiteSpace(tech.LastName)
                            ? tech.FirstName.Trim()
                            : (string.IsNullOrWhiteSpace(tech.FirstName) ? tech.LastName.Trim() : $"{tech.FirstName.Trim()} {tech.LastName.Trim()}");
                        <option value="@tech.ID">@displayName (@tech.Role)</option>
                    }
                </select>
                <span asp-validation-for="AssignedToStaffID" class="text-danger"></span>
                <div class="form-text text-muted small">Select an active laboratory technician to notify and assign this test order directly.</div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClinicalNotes" class="control-label fw-bold"></label>
                <textarea asp-for="ClinicalNotes" class="form-control" rows="3" placeholder="Enter diagnostic reason or clinical notes..."></textarea>
                <span asp-validation-for="ClinicalNotes" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Submit Lab Request" class="btn btn-primary" />
                @if (Model.EncounterID.HasValue)
                {
                    <a asp-controller="ClinicalEncounters" asp-action="Details" asp-route-id="@Model.EncounterID.Value" class="btn btn-secondary ms-2">Cancel</a>
                }
                else
                {
                    <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@Model.MedicalRecordID" class="btn btn-secondary ms-2">Cancel</a>
                }
            </div>
        </form>
    </div>
</div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
