@model HUIOTClinicMS.ViewModels.LabRequestCreateViewModel

@{
    ViewData["Title"] = "Create Lab Request";
}

<h2 class="mb-4">Create Lab Request</h2>

<div class="clinic-card max-w-600">
    <div class="mb-4">
        <strong>Patient:</strong> @Model.PatientDisplayName
    </div>
    
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <input type="hidden" asp-for="MedicalRecordID" />
            <input type="hidden" asp-for="PatientID" />

            <div class="form-group mb-3">
                <label class="control-label fw-bold">Tests to Request</label>
                <div class="border p-3 rounded bg-light">
                    @foreach (var test in Model.AvailableTestTypes)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedTestTypeIds" value="@test.ID" id="test_@test.ID" />
                            <label class="form-check-label" for="test_@test.ID">
                                @test.TestName
                            </label>
                        </div>
                    }
                </div>
                <span asp-validation-for="SelectedTestTypeIds" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClinicalNotes" class="control-label fw-bold"></label>
                <textarea asp-for="ClinicalNotes" class="form-control" rows="3" placeholder="Enter clinical notes..."></textarea>
                <span asp-validation-for="ClinicalNotes" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Submit Request" class="btn btn-primary" />
                <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@Model.MedicalRecordID" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
