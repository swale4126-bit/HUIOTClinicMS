@model HUIOTClinicMS.Models.LabRequest
@{
    ViewData["Title"] = "Delete Lab Request";
}

<h2 class="mb-4">Delete Lab Request</h2>

<div class="clinic-card mb-3">
    <p class="text-danger fw-semibold">Are you sure you want to delete this lab request? This cannot be undone.</p>
    <dl class="row mb-0">
        <dt class="col-sm-3">Patient</dt>
        <dd class="col-sm-9">@(Model.Patient != null ? $"{Model.Patient.FirstName} {Model.Patient.LastName}" : "—")</dd>
        <dt class="col-sm-3">Tests</dt>
        <dd class="col-sm-9">@(Model.TestTypes.Any() ? string.Join(", ", Model.TestTypes.Select(t => t.TestName)) : "—")</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="LabRequestID" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
</form>