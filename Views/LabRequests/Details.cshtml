@model HUIOTClinicMS.Models.LabRequest
@{
    ViewData["Title"] = "Lab Request Details";
    var badgeClass = Model.Status switch
    {
        "Completed" => "badge-status-completed",
        "In Progress" => "badge-status-inprogress",
        _ => "badge-status-pending"
    };
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="clinic-card mb-3">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <strong class="d-block">@(Model.Patient != null ? $"{Model.Patient.FirstName} {Model.Patient.LastName}" : "—")</strong>
            <span class="small text-muted">@Model.RequestDate.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        <div class="d-flex gap-2">
            <span class="badge @badgeClass align-self-center">@Model.Status</span>
            @if (Model.Status != "Completed")
            {
                <a asp-controller="LabResults" asp-action="Create" asp-route-labRequestId="@Model.LabRequestID" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-flask-vial me-1"></i> Enter Results & Handover
                </a>
            }
            <a asp-action="Edit" asp-route-id="@Model.LabRequestID" class="btn btn-outline-primary btn-sm">Update Status</a>
        </div>
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-3">Tests Requested</dt>
        <dd class="col-sm-9">@(Model.TestTypes.Any() ? string.Join(", ", Model.TestTypes.Select(t => t.TestName)) : "—")</dd>

        <dt class="col-sm-3">Clinical Notes</dt>
        <dd class="col-sm-9">@(Model.ClinicalNotes ?? "—")</dd>

        <dt class="col-sm-3">Requested By</dt>
        <dd class="col-sm-9">@(Model.RequestedBy != null ? $"{Model.RequestedBy.FirstName} {Model.RequestedBy.LastName}" : "—")</dd>

        <dt class="col-sm-3">Assigned Lab Tech</dt>
        <dd class="col-sm-9">
            @(Model.AssignedToStaff != null ? $"{Model.AssignedToStaff.FirstName} {Model.AssignedToStaff.LastName}" : "Unassigned (General Queue)")
            @if (Model.Status != "Completed")
            {
                <a asp-controller="TaskAssignment" asp-action="Reassign" asp-route-taskType="LabRequest" asp-route-taskId="@Model.LabRequestID" class="btn btn-outline-secondary btn-sm ms-2 py-0 px-2" style="font-size:0.75rem;">
                    <i class="fa-solid fa-user-pen me-1"></i>Reassign
                </a>
            }
        </dd>

        <dt class="col-sm-3">Related Medical Record</dt>
        <dd class="col-sm-9">
            <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@Model.MedicalRecordID">View Medical Record &rsaquo;</a>
        </dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Index" class="text-decoration-none">&lsaquo; Back to Lab Requests</a>
</div>