@model HUIOTClinicMS.ViewModels.LabTechDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="clinic-card">
            <div class="clinic-metric-value">@Model.PendingRequests</div>
            <div class="clinic-metric-label">Pending Requests</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clinic-card">
            <div class="clinic-metric-value">@Model.CompletedToday</div>
            <div class="clinic-metric-label">Completed Today</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="clinic-card">
            <div class="clinic-metric-value">@Model.TotalResults</div>
            <div class="clinic-metric-label">Total Results</div>
        </div>
    </div>
</div>

<div class="clinic-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <strong>Pending Lab Requests</strong>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>Patient</th>
                    <th>Test Type(s)</th>
                    <th>Notes</th>
                    <th>Requested By</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.PendingLabRequests)
                {
                    <tr>
                        <td>@(request.Patient != null ? $"{request.Patient.FirstName} {request.Patient.LastName}" : "—")</td>
                        <td class="small fw-semibold text-dark">
                            @(request.TestTypes != null && request.TestTypes.Any() ? string.Join(", ", request.TestTypes.Select(t => t.TestName)) : "—")
                        </td>
                        <td class="small text-muted">@(request.ClinicalNotes ?? "—")</td>
                        <td class="small">@(request.RequestedBy != null ? $"{request.RequestedBy.FirstName} {request.RequestedBy.LastName}" : "—")</td>
                        <td class="small text-muted">@request.RequestDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge badge-status-pending">@request.Status</span></td>
                        <td>
                            <a asp-controller="LabRequests" asp-action="Details" asp-route-id="@request.LabRequestID" class="btn btn-outline-primary btn-sm">View</a>
                            <a asp-controller="LabResults" asp-action="Create" asp-route-labRequestId="@request.LabRequestID" class="btn btn-primary btn-sm">Enter Results</a>
                        </td>
                    </tr>
                }
                @if (!Model.PendingLabRequests.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted small py-3">No pending lab requests.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="clinic-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <strong>In Progress Lab Requests</strong>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>Patient</th>
                    <th>Notes</th>
                    <th>Requested By</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.InProgressLabRequests)
                {
                    <tr>
                        <td>@(request.Patient != null ? $"{request.Patient.FirstName} {request.Patient.LastName}" : "—")</td>
                        <td class="small text-muted">@(request.ClinicalNotes ?? "—")</td>
                        <td class="small">@(request.RequestedBy != null ? $"{request.RequestedBy.FirstName} {request.RequestedBy.LastName}" : "—")</td>
                        <td class="small text-muted">@request.RequestDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge badge-status-inprogress">@request.Status</span></td>
                        <td>
                            <a asp-controller="LabRequests" asp-action="Details" asp-route-id="@request.LabRequestID" class="btn btn-outline-primary btn-sm">View</a>
                            <a asp-controller="LabResults" asp-action="Create" asp-route-labRequestId="@request.LabRequestID" class="btn btn-primary btn-sm">Enter Results</a>
                        </td>
                    </tr>
                }
                @if (!Model.InProgressLabRequests.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted small py-3">No in-progress lab requests.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

