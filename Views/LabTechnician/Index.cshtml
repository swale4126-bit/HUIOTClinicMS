                        <td class="small">@(request.RequestedBy != null ? $"{request.RequestedBy.FirstName} {request.RequestedBy.LastName}" : "—")</td>
                        <td class="small text-muted">@request.RequestDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge badge-status-completed">@request.Status</span></td>
                        <td>
                            <a asp-controller="LabRequests" asp-action="Details" asp-route-id="@request.LabRequestID" class="btn btn-outline-primary btn-sm">View</a>
