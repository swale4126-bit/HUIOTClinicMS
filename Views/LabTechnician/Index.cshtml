    <div class="d-flex justify-content-between align-items-center mb-3">
        <strong>Completed Lab Requests</strong>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>Patient</th>
                    <th>Notes</th>
                    <th>Requested By</th>
                    <th>Date</th>
                    <th>Status</th>
