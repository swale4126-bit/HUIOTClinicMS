            </div>
        </div>
    </div>
    
    <div class="text-center mt-5">
        <a href="/" class="btn btn-outline-primary px-4 shadow-sm"><i class="fa-solid fa-arrow-left me-2"></i> Back to Dashboard</a>
    </div>
</div>

<style>
    .clinic-hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .clinic-hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }
</style>
