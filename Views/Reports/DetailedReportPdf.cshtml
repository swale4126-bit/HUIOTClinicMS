@model HUIOTClinicMS.ViewModels.DetailedReportViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.ReportType - HU IoT Clinic</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            color: #0f172a;
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 12px;
            margin: 0;
            padding: 20px 0;
        }

        .report-page {
            max-width: 1100px;
            margin: 0 auto;
            background: #ffffff;
            padding: 32px 36px;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            border: 1px solid #e2e8f0;
        }

        .report-header {
            border-bottom: 2px solid #002D59;
            padding-bottom: 14px;
            margin-bottom: 20px;
        }

        .header-logo {
            width: 76px;
            height: 76px;
            object-fit: contain;
        }

        .kpi-box {
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 10px 8px;
            text-align: center;
            background-color: #f8fafc;
        }

        .kpi-box .num {
            font-size: 20px;
            font-weight: 700;
            color: #002D59;
            line-height: 1.1;
        }

        .kpi-box .label {
            font-size: 10px;
            text-transform: uppercase;
            font-weight: 600;
            color: #64748b;
            letter-spacing: 0.3px;
        }

        .clinical-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        .clinical-table th, .clinical-table td {
            border: 1px solid #cbd5e1;
            padding: 7px 8px;
            font-size: 11px;
            vertical-align: top;
        }

        .clinical-table th {
            background-color: #002D59;
            color: #ffffff;
            font-weight: 600;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .clinical-table tbody tr:nth-child(even) {
            background-color: #f8fafc;
        }

        .clinical-table tbody tr:hover {
            background-color: #f1f5f9;
        }

        .badge-emergency {
            background-color: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fecaca;
            font-size: 10px;
            padding: 2px 5px;
            border-radius: 4px;
            font-weight: 700;
        }

        .badge-referral {
            background-color: #fef3c7;
            color: #b45309;
            border: 1px solid #fde68a;
            font-size: 10px;
            padding: 2px 5px;
            border-radius: 4px;
            font-weight: 600;
        }

        .sign-block {
            border-top: 1px dashed #cbd5e1;
            margin-top: 30px;
            padding-top: 16px;
        }

        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .report-page {
                box-shadow: none;
                border: none;
                padding: 6mm 8mm;
                max-width: 100%;
            }
            .no-print {
                display: none !important;
            }
            .clinical-table {
                page-break-inside: auto;
            }
            .clinical-table tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }
        }
    </style>
</head>
<body>

    <!-- Action Toolbar (Hidden during Print) -->
    <div class="container mb-3 no-print" style="max-width: 1100px;">
        <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded shadow-sm border">
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Reports Dashboard
                </a>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="ExportDocx" asp-route-period="@Model.PeriodKey" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.AddDays(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-primary btn-sm px-3 fw-semibold">
                    <i class="fa-solid fa-file-word me-1 text-primary"></i> Download as DOCX (Word)
                </a>
                <button type="button" class="btn btn-primary btn-sm px-4 fw-semibold" onclick="window.print();">
                    <i class="fa-solid fa-print me-1"></i> Print / Download PDF
                </button>
            </div>
        </div>
    </div>

    <!-- Printable Clinical Report Page -->
    <div class="report-page">
        
        <!-- Header with Official Hawassa University Logo -->
        <div class="report-header">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <img src="~/images/hu-logo.png" alt="Hawassa University Logo" class="header-logo" />
                    <div>
                        <div class="text-uppercase fw-bold text-dark" style="font-size: 17px; letter-spacing: 0.5px;">Hawassa University</div>
                        <div class="fw-bold text-primary" style="font-size: 15px;">Institute of Technology (IoT) Student Health Clinic</div>
                        <div class="text-muted small">Campus Clinical Services &bull; Primary Healthcare & Emergency Unit &bull; Hawassa, Ethiopia</div>
                    </div>
                </div>
                <div class="text-end">
                    <div class="badge bg-primary px-2 py-1 mb-1 text-uppercase">Official Clinical Report</div>
                    <div class="text-muted small">Generated: <strong>@Model.GeneratedDate.ToString("MMM dd, yyyy HH:mm")</strong></div>
                    <div class="text-muted small">Period: <strong>@Model.StartDate.ToString("MMM dd, yyyy")</strong> &ndash; <strong>@Model.EndDate.AddDays(-1).ToString("MMM dd, yyyy")</strong></div>
                </div>
            </div>
            <div class="text-center mt-3 pt-2 border-top">
                <h5 class="fw-bold text-primary text-uppercase mb-0" style="letter-spacing: 0.3px;">@Model.ReportType</h5>
            </div>
        </div>

        <!-- Executive Statistics Summary KPI Grid -->
        <div class="row g-2 mb-3">
            <div class="col">
                <div class="kpi-box">
                    <div class="num">@Model.TotalVisits</div>
                    <div class="label">Total Patients</div>
                </div>
            </div>
            <div class="col">
                <div class="kpi-box">
                    <div class="num text-success">@Model.RoutineVisits</div>
                    <div class="label">Routine Cases</div>
                </div>
            </div>
            <div class="col">
                <div class="kpi-box">
                    <div class="num text-danger">@Model.EmergencyVisits</div>
                    <div class="label">Emergency Cases</div>
                </div>
            </div>
            <div class="col">
                <div class="kpi-box">
                    <div class="num text-warning">@Model.LabTestsCount</div>
                    <div class="label">Lab Orders</div>
                </div>
            </div>
            <div class="col">
                <div class="kpi-box">
                    <div class="num text-info">@Model.PrescriptionsCount</div>
                    <div class="label">Prescriptions</div>
                </div>
            </div>
            <div class="col">
                <div class="kpi-box">
                    <div class="num text-danger">@Model.ReferralsCount</div>
                    <div class="label">HUCSH Referrals</div>
                </div>
            </div>
        </div>

        <!-- Master Clinical Patient Attendance Register -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong class="text-dark small text-uppercase" style="letter-spacing: 0.5px;">
                <i class="fa-solid fa-list-check text-primary me-1"></i> Patient Clinical Attendance & Diagnosis Register (@Model.PatientsData.Count Patients)
            </strong>
            <span class="text-muted small">Standard Healthcare Facility Reporting Format</span>
        </div>

        <table class="clinical-table">
            <thead>
                <tr>
                    <th style="width: 3%;">#</th>
                    <th style="width: 9%;">Date/Time</th>
                    <th style="width: 14%;">Student ID & Card</th>
                    <th style="width: 15%;">Patient & Dept</th>
                    <th style="width: 6%;">Sex/Age</th>
                    <th style="width: 13%;">Vitals / Complaint</th>
                    <th style="width: 13%;">Diagnosis</th>
                    <th style="width: 11%;">Lab Diagnostics</th>
                    <th style="width: 10%;">Treatment Plan</th>
                    <th style="width: 6%;">Outcome</th>
                </tr>
            </thead>
            <tbody>
                @{ int sNo = 1; }
                @foreach (var item in Model.PatientsData)
                {
                    var p = item.Patient;
                    var isEmerg = item.Encounter?.Type == HUIOTClinicMS.Models.Enums.EncounterType.Emergency || item.Encounter?.Status == HUIOTClinicMS.Models.Enums.WorkflowState.InEmergency;
                    var triageVitals = item.Triage != null 
                        ? $"BP: {item.Triage.BloodPressure ?? "—"} | HR: {item.Triage.HeartRate?.ToString() ?? "—"} | T: {item.Triage.Temperature?.ToString() ?? "—"}°C" 
                        : "—";

                    var complaint = item.MedicalRecords.Any(m => !string.IsNullOrEmpty(m.ChiefComplaint))
                        ? string.Join("; ", item.MedicalRecords.Select(m => m.ChiefComplaint).Distinct())
                        : (isEmerg ? "STAT Emergency evaluation" : "General consultation");

                    var diagnosis = item.MedicalRecords.Any(m => !string.IsNullOrEmpty(m.Diagnosis))
                        ? string.Join("; ", item.MedicalRecords.Select(m => m.Diagnosis).Distinct())
                        : "Clinical evaluation in progress";

                    var labs = item.LabResults.Any()
                        ? string.Join("; ", item.LabResults.Select(r => $"{r.TestType?.TestName ?? "Test"}: {r.Result}"))
                        : (item.LabRequests.Any() ? $"{item.LabRequests.SelectMany(l => l.TestTypes).Count()} test(s) ordered" : "—");

                    var meds = item.Prescriptions.Any()
                        ? string.Join("; ", item.Prescriptions.Select(pr => !string.IsNullOrEmpty(pr.Medication?.MedicationName) ? $"{pr.Medication.MedicationName} ({pr.Medication.PrescribedDose ?? pr.RX})" : pr.RX))
                        : "—";

                    <tr>
                        <td class="text-center fw-bold">@(sNo++)</td>
                        <td>
                            <div>@item.VisitDate.ToString("MM/dd HH:mm")</div>
                            @if (isEmerg)
                            {
                                <span class="badge-emergency">STAT</span>
                            }
                        </td>
                        <td>
                            <strong class="text-primary">@p.IDNumber</strong>
                            <div class="text-muted small">Card: @(p.CardNumber ?? "—")</div>
                        </td>
                        <td>
                            <strong>@p.FirstName @p.LastName</strong>
                            <div class="text-muted small">@(p.Department?.DepartmentName ?? "—")</div>
                        </td>
                        <td>
                            <div>@p.Gender</div>
                            <small class="text-muted">@((DateTime.Today.Year - p.DateOfBirth.Year)) yrs</small>
                        </td>
                        <td>
                            <div>@complaint</div>
                            <div class="text-muted small" style="font-size: 9.5px;">@triageVitals</div>
                        </td>
                        <td>
                            <strong class="text-dark">@diagnosis</strong>
                        </td>
                        <td>
                            <div class="small">@labs</div>
                        </td>
                        <td>
                            <div class="small">@meds</div>
                        </td>
                        <td>
                            @if (item.Referral != null)
                            {
                                <span class="badge-referral">HUCSH</span>
                            }
                            else if (item.Encounter?.Status == HUIOTClinicMS.Models.Enums.WorkflowState.Discharged)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="font-size: 9px;">Discharged</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border" style="font-size: 9px;">Under Care</span>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.PatientsData.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">
                            <i class="fa-solid fa-folder-open d-block fa-2x mb-2 text-light"></i>
                            No patient attendance or clinical activity records found for this period.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Official Sign-off and Stamp Area -->
        <div class="sign-block">
            <div class="row text-center">
                <div class="col-4">
                    <div style="height: 40px;"></div>
                    <div class="border-top pt-1 small text-dark fw-bold">Prepared By</div>
                    <div class="text-muted small">Attending Clinician (Nurse / HO)</div>
                </div>
                <div class="col-4">
                    <div style="height: 40px;"></div>
                    <div class="border-top pt-1 small text-dark fw-bold">Verified By</div>
                    <div class="text-muted small">Chief Clinical Coordinator</div>
                </div>
                <div class="col-4">
                    <div style="height: 40px;"></div>
                    <div class="border-top pt-1 small text-dark fw-bold">Approved By & Clinic Stamp</div>
                    <div class="text-muted small">HU IoT Health Services Director</div>
                </div>
            </div>
        </div>

        <div class="text-center text-muted mt-3 pt-2 border-top" style="font-size: 10px;">
            Hawassa University Institute of Technology (IoT) Student Health Clinic &bull; System-Generated Official Report &bull; Hawassa, Ethiopia
        </div>

    </div>

</body>
</html>
