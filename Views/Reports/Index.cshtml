@model HUIOTClinicMS.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Reports Dashboard</h3>
    <div class="d-flex gap-2">
        <a asp-action="DailyReportPdf" class="btn btn-outline-primary" target="_blank"><i class="fa-solid fa-file-pdf me-2"></i>Daily Details PDF</a>
        <a asp-action="MonthlyReportPdf" class="btn btn-outline-primary" target="_blank"><i class="fa-solid fa-file-pdf me-2"></i>Monthly Details PDF</a>
        <button class="btn btn-primary" onclick="downloadPDF()"><i class="fa-solid fa-file-pdf me-2"></i>Dashboard Summary</button>
    </div>
</div>

<div id="report-content" class="p-3 bg-light rounded">
    <div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="clinic-card">
            <div class="clinic-metric-value">@Model.TotalPatients</div>
            <div class="clinic-metric-label">Total Patients</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="clinic-card">
            <div class="clinic-metric-value">@Model.TotalMedicalRecords</div>
            <div class="clinic-metric-label">Total Medical Records</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="clinic-card">
            <div class="clinic-metric-value">@Model.MedicalRecordsThisMonth</div>
            <div class="clinic-metric-label">Records This Month</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="clinic-card">
            <div class="clinic-metric-value">@Model.TotalMedicationsDispensed</div>
            <div class="clinic-metric-label">Medications Dispensed</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="clinic-card">
            <strong class="d-block mb-3">Lab Requests by Status</strong>
            <div class="d-flex justify-content-between mb-2">
                <span>Pending</span>
                <span class="badge badge-status-pending">@Model.LabRequestsPending</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span>In Progress</span>
                <span class="badge badge-status-inprogress">@Model.LabRequestsInProgress</span>
            </div>
            <div class="d-flex justify-content-between">
                <span>Completed</span>
                <span class="badge badge-status-completed">@Model.LabRequestsCompleted</span>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="clinic-card">
            <strong class="d-block mb-3">Prescriptions by Status</strong>
            <div class="d-flex justify-content-between mb-2">
                <span>Pending</span>
                <span class="badge badge-status-pending">@Model.PrescriptionsPending</span>
            </div>
            <div class="d-flex justify-content-between">
                <span>Dispensed</span>
                <span class="badge badge-status-completed">@Model.PrescriptionsDispensed</span>
            </div>
        </div>
    </div>
</div>

<div class="clinic-card">
    <strong class="d-block mb-3">Patients by Department</strong>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>Department</th>
                    <th>Patients</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.PatientsByDepartment)
                {
                    <tr>
                        <td>@d.DepartmentName</td>
                        <td>@d.Count</td>
                    </tr>
                }
                @if (!Model.PatientsByDepartment.Any())
                {
                    <tr><td colspan="2" class="text-center text-muted small py-3">No data yet.</td></tr>
                }
            </tbody>
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-6">
        <div class="clinic-card">
            <strong class="d-block mb-3"><i class="fa-solid fa-calendar-day me-2"></i>Daily Registered Patients (@DateTime.Today.ToString("MMM dd, yyyy"))</strong>
            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                <table class="table table-sm align-middle">
                    <thead class="sticky-top bg-white">
                        <tr class="text-muted small">
                            <th>ID Number</th>
                            <th>Name</th>
                            <th>Department</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.DailyPatients)
                        {
                            <tr>
                                <td>@p.IDNumber</td>
                                <td>@p.FirstName @p.LastName</td>
                                <td>@(p.Department?.DepartmentName ?? "—")</td>
                            </tr>
                        }
                        @if (!Model.DailyPatients.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted small py-3">No patients registered today.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="clinic-card">
            <strong class="d-block mb-3"><i class="fa-solid fa-calendar-days me-2"></i>Monthly Registered Patients (@DateTime.Today.ToString("MMMM yyyy"))</strong>
            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                <table class="table table-sm align-middle">
                    <thead class="sticky-top bg-white">
                        <tr class="text-muted small">
                            <th>ID Number</th>
                            <th>Name</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.MonthlyPatients)
                        {
                            <tr>
                                <td>@p.IDNumber</td>
                                <td>@p.FirstName @p.LastName</td>
                                <td>@p.CreatedAt.ToString("MMM dd")</td>
                            </tr>
                        }
                        @if (!Model.MonthlyPatients.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted small py-3">No patients registered this month.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div> <!-- End report-content -->

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        function downloadPDF() {
            var element = document.getElementById('report-content');
            var opt = {
                margin:       0.5,
                filename:     'Clinic_Summary_Report_@(DateTime.Today.ToString("yyyyMMdd")).pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
}