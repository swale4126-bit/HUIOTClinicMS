@model HUIOTClinicMS.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
    <div>
        <h5 class="d-flex align-items-center text-dark fw-bold mb-1">
            <i class="fa-solid fa-chart-line text-primary me-2"></i> Reports Dashboard
        </h5>
        <div class="text-muted small">Generate and export official clinic activity registers, statistics, and attendance summaries</div>
    </div>
    
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <!-- Start Date Picker -->
        <div class="d-flex align-items-center bg-white border rounded px-2 py-1 shadow-sm">
            <label for="reportStartDate" class="form-label mb-0 text-muted small fw-semibold me-2 text-nowrap">
                <i class="fa-regular fa-calendar text-primary me-1"></i>Start Date:
            </label>
            <input type="date" id="reportStartDate" class="form-control form-control-sm border-0 p-0 shadow-none bg-transparent" style="width: 125px;" value="@(Model.StartDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
        </div>

        <!-- End Date Picker -->
        <div class="d-flex align-items-center bg-white border rounded px-2 py-1 shadow-sm">
            <label for="reportEndDate" class="form-label mb-0 text-muted small fw-semibold me-2 text-nowrap">
                <i class="fa-regular fa-calendar text-primary me-1"></i>End Date:
            </label>
            <input type="date" id="reportEndDate" class="form-control form-control-sm border-0 p-0 shadow-none bg-transparent" style="width: 125px;" value="@(Model.EndDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
        </div>

        <!-- Consolidated Download Report Dropdown -->
        <div class="dropdown">
            <button class="btn btn-primary btn-sm dropdown-toggle shadow-sm d-flex align-items-center fw-semibold px-3 py-1" type="button" id="downloadReportDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="min-height: 33px;">
                <i class="fa-solid fa-cloud-arrow-down me-2"></i> Download Report
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2" aria-labelledby="downloadReportDropdown" style="min-width: 280px;">
                <!-- Daily Category -->
                <li class="dropdown-header text-uppercase fw-bold text-dark small px-3 pt-2 pb-1">
                    <i class="fa-solid fa-calendar-day me-1 text-primary"></i> Daily Report
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center px-3 py-2 report-download-link" href="@Url.Action("DailyReportPdf", "Reports")" data-base-url="@Url.Action("DailyReportPdf", "Reports")" target="_blank">
                        <i class="fa-regular fa-file-pdf me-2 text-danger fs-5"></i>
                        <div>
                            <div class="fw-semibold text-dark">Daily PDF</div>
                            <small class="text-muted d-block" style="font-size: 11px;">View &amp; Print Official PDF Register</small>
                        </div>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center px-3 py-2 report-download-link" href="@Url.Action("ExportDocx", "Reports", new { period = "daily" })" data-base-url="@Url.Action("ExportDocx", "Reports", new { period = "daily" })">
                        <i class="fa-solid fa-file-word me-2 text-primary fs-5"></i>
                        <div>
                            <div class="fw-semibold text-dark">Daily DOCX</div>
                            <small class="text-muted d-block" style="font-size: 11px;">Download Microsoft Word Document</small>
                        </div>
                    </a>
                </li>

                <li><hr class="dropdown-divider my-2"></li>

                <!-- Monthly Category -->
                <li class="dropdown-header text-uppercase fw-bold text-dark small px-3 pt-2 pb-1">
                    <i class="fa-solid fa-calendar-days me-1 text-success"></i> Monthly Report
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center px-3 py-2 report-download-link" href="@Url.Action("MonthlyReportPdf", "Reports")" data-base-url="@Url.Action("MonthlyReportPdf", "Reports")" target="_blank">
                        <i class="fa-regular fa-file-pdf me-2 text-danger fs-5"></i>
                        <div>
                            <div class="fw-semibold text-dark">Monthly PDF</div>
                            <small class="text-muted d-block" style="font-size: 11px;">View &amp; Print Monthly PDF Register</small>
                        </div>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center px-3 py-2 report-download-link" href="@Url.Action("ExportDocx", "Reports", new { period = "monthly" })" data-base-url="@Url.Action("ExportDocx", "Reports", new { period = "monthly" })">
                        <i class="fa-solid fa-file-word me-2 text-primary fs-5"></i>
                        <div>
                            <div class="fw-semibold text-dark">Monthly DOCX</div>
                            <small class="text-muted d-block" style="font-size: 11px;">Download Microsoft Word Document</small>
                        </div>
                    </a>
                </li>

                <li><hr class="dropdown-divider my-2"></li>

                <!-- Annual Category -->
                <li class="dropdown-header text-uppercase fw-bold text-dark small px-3 pt-2 pb-1">
                    <i class="fa-solid fa-calendar me-1 text-warning"></i> Annual Report
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center px-3 py-2 report-download-link" href="@Url.Action("AnnualReportPdf", "Reports")" data-base-url="@Url.Action("AnnualReportPdf", "Reports")" target="_blank">
                        <i class="fa-regular fa-file-pdf me-2 text-danger fs-5"></i>
                        <div>
                            <div class="fw-semibold text-dark">Annual PDF</div>
                            <small class="text-muted d-block" style="font-size: 11px;">View &amp; Print Annual PDF Register</small>
                        </div>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center px-3 py-2 report-download-link" href="@Url.Action("ExportDocx", "Reports", new { period = "annual" })" data-base-url="@Url.Action("ExportDocx", "Reports", new { period = "annual" })">
                        <i class="fa-solid fa-file-word me-2 text-primary fs-5"></i>
                        <div>
                            <div class="fw-semibold text-dark">Annual DOCX</div>
                            <small class="text-muted d-block" style="font-size: 11px;">Download Microsoft Word Document</small>
                        </div>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<div id="report-content" class="p-3 bg-light rounded border shadow-sm">
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                    <i class="fa-solid fa-users fs-4"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">@Model.TotalPatients</h3>
                <small class="text-muted fw-medium text-uppercase" style="letter-spacing: 0.5px;">Total Patients</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                    <i class="fa-solid fa-file-medical fs-4"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">@Model.TotalMedicalRecords</h3>
                <small class="text-muted fw-medium text-uppercase" style="letter-spacing: 0.5px;">Total Records</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                    <i class="fa-solid fa-calendar-check fs-4"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">@Model.MedicalRecordsThisMonth</h3>
                <small class="text-muted fw-medium text-uppercase" style="letter-spacing: 0.5px;">Records This Month</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="clinic-card border-0 shadow-sm text-center py-4 h-100">
                <div class="bg-info bg-opacity-10 text-info rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 50px; height: 50px;">
                    <i class="fa-solid fa-pills fs-4"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">@Model.TotalMedicationsDispensed</h3>
                <small class="text-muted fw-medium text-uppercase" style="letter-spacing: 0.5px;">Meds Dispensed</small>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="clinic-card border-0 shadow-sm h-100">
                <strong class="d-block mb-4 text-dark"><i class="fa-solid fa-flask text-warning me-2"></i> Lab Requests by Status</strong>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-medium">Pending</span>
                    <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 fs-6">@Model.LabRequestsPending</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-medium">In Progress</span>
                    <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2 fs-6">@Model.LabRequestsInProgress</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted fw-medium">Completed</span>
                    <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 fs-6">@Model.LabRequestsCompleted</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="clinic-card border-0 shadow-sm h-100">
                <strong class="d-block mb-4 text-dark"><i class="fa-solid fa-prescription-bottle text-success me-2"></i> Prescriptions by Status</strong>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-medium">Pending</span>
                    <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2 fs-6">@Model.PrescriptionsPending</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted fw-medium">Dispensed</span>
                    <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 fs-6">@Model.PrescriptionsDispensed</span>
                </div>
            </div>
        </div>
    </div>

    <div class="clinic-card border-0 shadow-sm mb-4">
        <strong class="d-block mb-3 text-dark"><i class="fa-solid fa-building-user text-primary me-2"></i> Patients by Department</strong>
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="fw-semibold py-2">Department</th>
                        <th class="fw-semibold py-2 text-end">Patients</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var d in Model.PatientsByDepartment)
                    {
                        <tr>
                            <td class="fw-medium text-dark py-2">@d.DepartmentName</td>
                            <td class="text-end py-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2">@d.Count</span>
                            </td>
                        </tr>
                    }
                    @if (!Model.PatientsByDepartment.Any())
                    {
                        <tr><td colspan="2" class="text-center text-muted py-4"><i class="fa-solid fa-building-circle-xmark d-block fa-2x text-light mb-2"></i>No data yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-6">
            <div class="clinic-card border-0 shadow-sm h-100">
                <strong class="d-block mb-3 text-dark"><i class="fa-solid fa-calendar-day text-info me-2"></i> Daily Registered (@DateTime.Today.ToString("MMM dd"))</strong>
                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="sticky-top table-light text-muted small text-uppercase">
                            <tr>
                                <th class="fw-semibold py-2">ID</th>
                                <th class="fw-semibold py-2">Name</th>
                                <th class="fw-semibold py-2">Department</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var p in Model.DailyPatients)
                            {
                                <tr>
                                    <td class="small text-muted py-2">@p.IDNumber</td>
                                    <td class="fw-medium text-dark py-2">@p.FirstName @p.LastName</td>
                                    <td class="small text-secondary py-2 text-truncate" style="max-width: 120px;" title="@(p.Department?.DepartmentName)">@(p.Department?.DepartmentName ?? "—")</td>
                                </tr>
                            }
                            @if (!Model.DailyPatients.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted py-4">No patients registered today.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="clinic-card border-0 shadow-sm h-100">
                <strong class="d-block mb-3 text-dark"><i class="fa-solid fa-calendar-days text-primary me-2"></i> Monthly Registered (@DateTime.Today.ToString("MMM yyyy"))</strong>
                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="sticky-top table-light text-muted small text-uppercase">
                            <tr>
                                <th class="fw-semibold py-2">ID</th>
                                <th class="fw-semibold py-2">Name</th>
                                <th class="fw-semibold py-2">Date</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var p in Model.MonthlyPatients)
                            {
                                <tr>
                                    <td class="small text-muted py-2">@p.IDNumber</td>
                                    <td class="fw-medium text-dark py-2">@p.FirstName @p.LastName</td>
                                    <td class="small text-secondary py-2">@p.CreatedAt.ToString("MMM dd")</td>
                                </tr>
                            }
                            @if (!Model.MonthlyPatients.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted py-4">No patients registered this month.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div> <!-- End report-content -->

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const startInput = document.getElementById('reportStartDate');
            const endInput = document.getElementById('reportEndDate');
            const downloadLinks = document.querySelectorAll('.report-download-link');

            function updateDownloadLinks() {
                const startVal = startInput ? startInput.value : '';
                const endVal = endInput ? endInput.value : '';

                downloadLinks.forEach(function (link) {
                    const baseUrl = link.getAttribute('data-base-url') || link.getAttribute('href');
                    if (!baseUrl) return;

                    const url = new URL(baseUrl, window.location.origin);
                    if (startVal) {
                        url.searchParams.set('startDate', startVal);
                    } else {
                        url.searchParams.delete('startDate');
                    }
                    if (endVal) {
                        url.searchParams.set('endDate', endVal);
                    } else {
                        url.searchParams.delete('endDate');
                    }
                    link.href = url.pathname + url.search;
                });
            }

            if (startInput) {
                startInput.addEventListener('change', updateDownloadLinks);
                startInput.addEventListener('input', updateDownloadLinks);
            }
            if (endInput) {
                endInput.addEventListener('change', updateDownloadLinks);
                endInput.addEventListener('input', updateDownloadLinks);
            }

            // Initialize link URLs with current picker values
            updateDownloadLinks();

            // Client-side validation: prevent clicking if Start Date > End Date
            downloadLinks.forEach(function (link) {
                link.addEventListener('click', function (e) {
                    const startVal = startInput ? startInput.value : '';
                    const endVal = endInput ? endInput.value : '';
                    if (startVal && endVal && startVal > endVal) {
                        e.preventDefault();
                        alert('Start Date cannot be after End Date. Please select a valid date range.');
                        return false;
                    }
                });
            });
        });

        function downloadPDF() {
            var element = document.getElementById('report-content');
            var opt = {
                margin:       0.5,
                filename:     'Clinic_Summary_Report_@(DateTime.Today.ToString("yyyyMMdd")).pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
}